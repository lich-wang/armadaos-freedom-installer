<Window x:Class="FreedomInstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FreedomInstaller.App"
        Title="{DynamicResource Static.Title}"
        Width="1100"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="{DynamicResource ArmadaBrandMark}"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI, Arial"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        全部颜色都走 DynamicResource：本文件不写死任何色值，浅色 / 深色由 Themes/Light.xaml、
        Themes/Dark.xaml 两份字典提供，键名一一对应，切换时整体生效。
    -->
    <Window.Resources>

        <!--
            仓库风帆标记：两条路径原样取自 .github/assets/armada-mark-black.svg / armada-mark-white.svg
            （viewBox 0 0 512 512，作者 Rax）。外层透明矩形把范围固定为 512×512，缩放时比例不变。
            纯 WPF 矢量，随主题用 InkBrush 着色，窗口图标也引用同一资源。
        -->
        <DrawingImage x:Key="ArmadaBrandMark">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,512,512" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource InkBrush}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M316.315 63.5C324.671 102.812 329.069 143.587 329.069 185.389C329.069 256.56 316.323 324.753 292.994 387.813C280.821 386.354 268.43 385.603 255.863 385.603C201.724 385.603 150.84 399.54 106.604 424.022C213.937 333.588 290.014 207.24 316.315 63.5Z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource InkBrush}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M356.398 169.27C377.349 214.386 389.045 264.671 389.045 317.689C389.045 349.698 384.781 380.71 376.793 410.191C356.908 401.716 335.953 395.269 314.186 391.106C341.415 323.756 356.411 250.15 356.411 173.041C356.411 171.783 356.406 170.526 356.398 169.27Z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ===== 滚动条零件（日志与下拉列表里的滚动条也要跟着主题走） ===== -->
        <ControlTemplate x:Key="InvisibleRepeatButtonTemplate" TargetType="RepeatButton">
            <Border Background="Transparent" />
        </ControlTemplate>

        <ControlTemplate x:Key="ScrollThumbTemplate" TargetType="Thumb">
            <Border x:Name="ThumbChrome"
                    Background="{DynamicResource ScrollThumbBrush}"
                    CornerRadius="4"
                    Margin="2" />
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False"
                                                  Template="{StaticResource InvisibleRepeatButtonTemplate}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Template="{StaticResource ScrollThumbTemplate}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False"
                                                  Template="{StaticResource InvisibleRepeatButtonTemplate}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Focusable="False"
                                                          Template="{StaticResource InvisibleRepeatButtonTemplate}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinWidth="24" Template="{StaticResource ScrollThumbTemplate}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Focusable="False"
                                                          Template="{StaticResource InvisibleRepeatButtonTemplate}" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 文字 ===== -->
        <Style x:Key="H1Text" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="H2Text" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyInkText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- ===== 容器 ===== -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SoftPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <!-- ===== 按钮 ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionToggle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!--
            可折叠分组（还原原始文件 / 旧版安装记录）。
            默认 Expander 模板的箭头取自系统颜色，深色主题下几乎看不见；
            这里用主题键重画箭头与标题底色，浅色 / 深色都与卡片一致，不写入任何色值。
        -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          Focusable="False"
                                          Cursor="Hand"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderChrome"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="2,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Arrow"
                                                      Data="M 0 0 L 5 5 L 0 10"
                                                      Stroke="{DynamicResource AccentBrush}"
                                                      StrokeThickness="1.8"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      RenderTransformOrigin="0.5,0.5" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              ContentSource="Content"
                                              Margin="0,4,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="11"
                                Padding="8,8"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Marker"
                                        Grid.Column="0"
                                        Width="3"
                                        CornerRadius="1.5"
                                        Background="Transparent"
                                        Margin="0,2,10,2" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Marker" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 输入 ===== -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectedBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource StrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Data="M 0 0 L 5 6 L 10 0"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.8" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="4"
                                        Margin="0,6,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapacitySliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="8"
                                    CornerRadius="4"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{DynamicResource SurfaceBrush}"
                                                             Stroke="{DynamicResource AccentBrush}"
                                                             StrokeThickness="2" />
                                                    <Ellipse Width="8"
                                                             Height="8"
                                                             Fill="{DynamicResource AccentBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="8" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RiskCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="5"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top"
                                    Margin="0,2,10,0">
                                <Path x:Name="Mark"
                                      Data="M 0 4 L 3 7 L 9 0"
                                      Stroke="{DynamicResource AccentInkBrush}"
                                      StrokeThickness="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 功能卡片（首页六张入口卡片） ===== -->
        <!--
            卡片本身就是按钮：边框、悬停与键盘焦点反馈全在模板里，颜色只用主题键，
            因此浅色 / 深色切换后自动跟随。卡片内文字是普通 TextBlock（不放进 Viewbox），
            宽度不够时按 TextWrapping 折行，不缩放字号。
        -->
        <Style x:Key="FunctionCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="106" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="CardChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片左侧的小图标底框：图标本身是内联矢量 Path，不引入任何图片或新依赖。 -->
        <Style x:Key="FunctionCardIcon" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,12,0" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部：品牌 + 主题切换 ================= -->
        <Grid Grid.Row="0" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 星号列约束副标题宽度，说明文字需要换行时在列内自然折行。 -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="{DynamicResource ArmadaBrandMark}"
                       Width="48"
                       Height="48"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       ToolTip="ArmadaOS"
                       AutomationProperties.Name="ArmadaOS" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ArmadaOS Freedom"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="{DynamicResource Static.BrandSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!--
                支持入口：只切换视图去独立支持页，不进入安装向导，也不改动当前选中的功能、
                已读到的设备状态或任何输入。星号列仍留给品牌副标题，宽度不够时在列内折行。
            -->
            <Button x:Name="SupportProjectButton"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnShowSupport"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    Margin="0,0,8,0">
                <TextBlock Text="{DynamicResource Static.SupportButton}"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </Button>

            <Button x:Name="ThemeToggleButton"
                    Grid.Column="2"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnToggleTheme"
                    VerticalAlignment="Center"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Border Width="12"
                            Height="12"
                            CornerRadius="6"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ThemeToggleText"
                               Text="{DynamicResource Static.ThemeLabelDark}"
                               FontSize="13"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 语言按钮只在两种界面语言之间切换；按钮显示的是「切换目标」，不是当前语言。 -->
            <Button x:Name="LanguageToggleButton"
                    Grid.Column="3"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnToggleLanguage"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    Margin="8,0,0,0"
                    ToolTip="{DynamicResource Static.LanguageTooltip}">
                <TextBlock x:Name="LanguageToggleText"
                           Text="{DynamicResource Static.LanguageToggleLabel}"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </Button>
        </Grid>

        <!-- ================= 主体：左侧步骤 + 页内内容 ================= -->
        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：只放步骤，不再叠作者卡片，因此顶部对齐、高度随内容收缩。
                 首页不显示这一列，进入某个功能的向导后才由 ApplyFunctionView() 打开。 -->
            <Border x:Name="WorkflowSidebar"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <StackPanel>
                    <!-- 任意一步都能回到功能选择：只切视图，不发起查询、不清空已读到的状态。 -->
                    <Button x:Name="BackToFunctionsButton"
                            Style="{StaticResource GhostButton}"
                            Click="OnBackToFunctions"
                            Padding="8,4"
                            Margin="0,0,0,10" />

                    <TextBlock Text="{DynamicResource Static.NavSelectedFunction}"
                               Style="{StaticResource CaptionText}"
                               Margin="8,0,0,2" />
                    <TextBlock x:Name="SelectedOperationText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               TextWrapping="Wrap"
                               Margin="8,0,0,10" />

                    <TextBlock Text="{DynamicResource Static.NavTitle}"
                               Style="{StaticResource CaptionText}"
                               Margin="8,4,0,8" />

                    <!-- 原有三页步骤标签：TF 卡安装、更新前准备、更新后修复、恢复 boot 与卸载继续使用。 -->
                    <StackPanel x:Name="LegacyStepNav">
                        <RadioButton x:Name="NavConnect"
                                     GroupName="StepNav"
                                     Style="{StaticResource StepNavItem}"
                                     IsChecked="True"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="01" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.NavConnect}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavCapacity"
                                     GroupName="StepNav"
                                     Style="{StaticResource StepNavItem}"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="02" FontSize="11" />
                                <!-- 文案随功能变化（TF 卡「选择 TF 卡」/ 卸载「恢复空间」）。 -->
                                <TextBlock x:Name="NavCapacityLabel" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavConfirm"
                                     GroupName="StepNav"
                                     Style="{StaticResource StepNavItem}"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <TextBlock Text="03" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.NavConfirm}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 内部存储专用的四步标签：与上面的旧三页互斥显示，勾选同样受导航门槛约束。 -->
                    <StackPanel x:Name="InternalInstallStepNav" Visibility="Collapsed">
                        <RadioButton x:Name="InternalInstallNavCheck"
                                     GroupName="InternalInstallSteps"
                                     Style="{StaticResource StepNavItem}"
                                     Tag="0"
                                     IsChecked="True"
                                     Checked="OnInternalInstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="01" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Connect}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="InternalInstallNavBackup"
                                     GroupName="InternalInstallSteps"
                                     Style="{StaticResource StepNavItem}"
                                     Tag="1"
                                     Checked="OnInternalInstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="02" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Backup}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="InternalInstallNavCapacity"
                                     GroupName="InternalInstallSteps"
                                     Style="{StaticResource StepNavItem}"
                                     Tag="2"
                                     Checked="OnInternalInstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="03" FontSize="11" />
                                <TextBlock x:Name="SharedWorkflowThirdStepText" Text="{DynamicResource Static.InternalInstall.Nav.Capacity}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="InternalInstallNavConfirm"
                                     GroupName="InternalInstallSteps"
                                     Style="{StaticResource StepNavItem}"
                                     Tag="3"
                                     Checked="OnInternalInstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="04" FontSize="11" />
                                <TextBlock x:Name="SharedWorkflowConfirmStepText" Text="{DynamicResource Static.InternalInstall.Nav.Confirm}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 页内内容（向导本体）：首页时整体隐藏，选中功能后才显示。 -->
            <ScrollViewer x:Name="WorkflowScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0"
                          Margin="0,0,0,12"
                          Visibility="Collapsed">
                <Grid>

                    <!-- TF 安装入口的读取方式选择：进入「安装到 TF 卡」即显示，独立于下方新旧向导容器的切换。 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="TfEntrySelectionPanel"
                            Grid.Row="0"
                            Style="{StaticResource CardBorder}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.TfSourceGroup}"
                                       Style="{StaticResource FieldLabelText}"
                                       Margin="0,0,0,6" />
                            <WrapPanel>
                                <RadioButton x:Name="TfSourceTabletRadio"
                                             GroupName="TfSource"
                                             Content="{DynamicResource Static.TfSourceTablet}"
                                             FontSize="13"
                                             IsChecked="True"
                                             Checked="OnTfSourceChanged"
                                             Margin="0,0,20,0" />
                                <RadioButton x:Name="TfSourceReaderRadio"
                                             GroupName="TfSource"
                                             Content="{DynamicResource Static.TfSourceReader}"
                                             FontSize="13"
                                             Checked="OnTfSourceChanged" />
                            </WrapPanel>

                            <TextBlock x:Name="TfSourceHintText"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <TextBlock x:Name="TfTabletHostDriverStatusText"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 原有三页内容整体放进一个命名容器，方便内部安装在两组内容之间切换。 -->
                    <Grid x:Name="LegacyWorkflowPages" Grid.Row="1">

                    <!-- ================= 01 连接平板 ================= -->
                    <StackPanel x:Name="PageConnect">
                        <TextBlock Text="{DynamicResource Static.ConnectTitle}" Style="{StaticResource H1Text}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Margin="0,4,0,0"
                                   Text="{DynamicResource Static.ConnectLead}" />

                        <TextBlock Text="{DynamicResource Static.Connection.Gen4UsbPortHint}"
                                   Style="{StaticResource BodyInkText}"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />

                        <!--
                            要执行的操作在首页卡片上选定，本页只保留一行普通说明：
                            不再有安装模式下拉菜单，也不留任何隐藏的模式控件当状态。
                        -->
                        <TextBlock x:Name="ModeHintText"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,6,0,0" />

                        <!-- 连接区去掉多余卡片描边与内边距：ConnectionGuide 自带边框，这里只做无样式的容器。 -->
                        <Border Padding="0" Background="Transparent" BorderThickness="0">
                            <StackPanel>
                                <!-- 连接帮助（首次安装时由 OnLoaded 自动展开） -->
                                <Button x:Name="ConnectHelpToggle"
                                        Content="{DynamicResource Static.HelpToggle}"
                                        Style="{StaticResource SectionToggle}"
                                        Margin="0"
                                        Padding="0,4"
                                        Click="OnToggleConnectHelp" />
                                <Border x:Name="ConnectHelpPanel"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,4,0,0"
                                        Visibility="Collapsed">
                                    <local:ConnectionGuide x:Name="SharedConnectionGuide" />
                                </Border>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="DetectButton"
                                            Content="{DynamicResource Static.Detect}"
                                            Click="OnDetectDevices"
                                            Style="{StaticResource PrimaryButton}" />
                                    <Button x:Name="CheckBootloaderButton"
                                            Content="{DynamicResource Static.CheckBootloader}"
                                            Click="OnCheckBootloader"
                                            Style="{StaticResource SecondaryButton}"
                                            IsEnabled="False"
                                            Margin="10,0,0,0" />
                                </WrapPanel>

                                <ComboBox x:Name="DevicesCombo"
                                          Style="{StaticResource ThemeComboBox}"
                                          ItemContainerStyle="{StaticResource ThemeComboBoxItem}"
                                          SelectionChanged="OnDeviceSelected"
                                          IsEnabled="False"
                                          Margin="0,14,0,0" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.FieldStatus}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ConnectionStatusText" Text="{DynamicResource Static.StatusNoDevice}" Style="{StaticResource FieldValueText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.FieldModel}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ModelText" Text="—" Style="{StaticResource FieldValueText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.FieldSerial}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SerialText" Text="—" Style="{StaticResource FieldValueText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.FieldBootState}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BootStateText" Text="{DynamicResource Static.BootPending}" Style="{StaticResource FieldValueText}" />

                                    <!--
                                        固件 / Android 版本 / Android 上报的 BL 状态都是只读查询结果：
                                        固件优先显示设备上报的显示 ID，缺失时退回构建指纹；
                                        Android 上报与上面的「BL 解锁状态」是两件事，绝不合成一个结论。
                                    -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Static.FieldFirmware}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="FirmwareText" Text="—" Style="{StaticResource FieldValueText}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Static.FieldAndroidVersion}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="AndroidVersionText" Text="—" Style="{StaticResource FieldValueText}" />
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Static.FieldAndroidBl}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="AndroidBootReportText" Text="—" Style="{StaticResource FieldValueText}" />
                                </Grid>

                                <TextBlock Text="{DynamicResource Static.BootCompatAndroidNote}"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,0,0,4" />

                                <!-- 路线结论紧接在设备事实之后；这里不重复设备行，也不引入任何路线下拉框。 -->
                                <Border x:Name="BootCompatPanel"
                                        Style="{StaticResource SoftPanel}"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Static.BootCompatTitle}"
                                                   Style="{StaticResource H2Text}"
                                                   FontSize="14" />
                                        <TextBlock Text="{DynamicResource Static.BootCompatTb322Fc}"
                                                   Style="{StaticResource BodyText}"
                                                   FontSize="12.5"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="{DynamicResource Static.BootCompatTb323Fu}"
                                                   Style="{StaticResource BodyText}"
                                                   FontSize="12.5"
                                                   Margin="0,4,0,0" />
                                        <TextBlock x:Name="BootRouteStatusText"
                                                   Style="{StaticResource BodyInkText}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0" />
                                        <TextBlock x:Name="BootRouteNextStepText"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="DeviceHintText"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,6,0,0"
                                           Text="{DynamicResource Static.DeviceHintInitial}" />

                                <Button x:Name="AdvancedToggle"
                                        Content="{DynamicResource Static.AdvancedToggle}"
                                        Style="{StaticResource SectionToggle}"
                                        Click="OnToggleAdvanced" />
                                <Border x:Name="AdvancedPanel" Style="{StaticResource SoftPanel}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Text="{DynamicResource Static.AdvancedLead}" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ToolsPathBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource InputTextBox}"
                                                     TextChanged="OnToolsPathChanged"
                                                     VerticalContentAlignment="Center" />
                                            <Button x:Name="BrowseToolsButton"
                                                    Grid.Column="1"
                                                    Content="{DynamicResource Static.Browse}"
                                                    Click="OnBrowseTools"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="10,0,0,0" />
                                        </Grid>
                                        <TextBlock x:Name="ToolsStatusText"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,8,0,0"
                                                   Text="{DynamicResource Static.ToolsStatusInitial}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--
                            卸载专用：9008 自动维护入口。
                            连接并确认 9008 端点后，由「校验还原方案」执行只读分区读取与准备；初始 Collapsed。
                        -->
                        <Border x:Name="UninstallEdlSection"
                                Style="{StaticResource CardBorder}"
                                Margin="0,20,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Edl.Title}"
                                           Style="{StaticResource H2Text}" />
                                <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Edl.Lead}"
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{DynamicResource Static.Connection.Gen4UsbPortHint}"
                                           Style="{StaticResource BodyInkText}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />

                                <!-- 工作目录只经由「浏览…」写入：输出路径与已保存文件必须保持一一对应。 -->
                                <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.EdlRestore.WorkRootLabel}"
                                           Style="{StaticResource FieldLabelText}"
                                           Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UninstallWorkRootBox"
                                             Grid.Column="0"
                                             Style="{StaticResource InputTextBox}"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Center" />
                                    <Button x:Name="BrowseUninstallWorkRootButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Static.Browse}"
                                            Click="OnBrowseUninstallWorkRoot"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" />
                                </Grid>

                                <Button x:Name="EnterUninstallEdlButton"
                                        Content="{DynamicResource Dynamic.UninstallFlow.Edl.Button}"
                                        Click="OnEnterUninstallEdl"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0" />
                                <TextBlock x:Name="UninstallEdlStatusText"
                                           Text="{DynamicResource Dynamic.UninstallFlow.Edl.NeedDevice}"
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                                <TextBlock x:Name="UninstallEdlPowerText"
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="{DynamicResource Dynamic.UninstallFlow.EdlRestore.PowerUnknown}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ================= 02 分配空间 / 恢复安卓存储空间 ================= -->
                    <StackPanel x:Name="PageCapacity" Visibility="Collapsed">
                        <TextBlock x:Name="CapacityPageTitle" Text="{DynamicResource Static.CapacityTitle}" Style="{StaticResource H1Text}" />
                        <TextBlock x:Name="CapacityPageLead"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,10,0,0"
                                   Text="{DynamicResource Static.CapacityLead}" />

                        <!--
                            TF 卡安装：只在「安装到 TF 卡」时出现，且放在本页最上面。
                            两种读取方式二选一，读到真实卡片后由用户自己选目标卡（列表从不自动选中）；
                            容量只按卡片总容量和安装包声明估算，因此这里没有内部安装的滑条。
                        -->
                        <Border x:Name="TfCardSection"
                                Style="{StaticResource CardBorder}"
                                Margin="0,20,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.TfCardTitle}" Style="{StaticResource H2Text}" />

                                <Button x:Name="ReadTfCardsButton"
                                        Content="{DynamicResource Static.ReadTfCards}"
                                        Click="OnReadTfCards"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0" />

                                <TextBlock Text="{DynamicResource Static.TfCardPickLabel}"
                                           Style="{StaticResource FieldLabelText}"
                                           Margin="0,16,0,6" />
                                <!-- 只列出真实读到的卡片；不预选第一项，避免把「默认值」当成用户的选择。 -->
                                <ComboBox x:Name="TfCardsCombo"
                                          Style="{StaticResource ThemeComboBox}"
                                          ItemContainerStyle="{StaticResource ThemeComboBoxItem}"
                                          SelectionChanged="OnTfCardChanged"
                                          IsEnabled="False" />

                                <TextBlock x:Name="TfStatusText"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Text="{DynamicResource Static.TfStatusInitial}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.TfField.Total}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TfTotalText" Text="—" Style="{StaticResource FieldValueText}" Margin="20,0,0,10" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.TfField.Boot}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TfBootText" Text="—" Style="{StaticResource FieldValueText}" Margin="20,0,0,10" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.TfField.Root}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TfRootText" Text="—" Style="{StaticResource FieldValueText}" Margin="20,0,0,10" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.TfField.Data}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TfDataText" Text="—" Style="{StaticResource FieldValueText}" Margin="20,0,0,10" />
                                </Grid>

                                <TextBlock x:Name="TfPlanStatusText"
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           Text="{DynamicResource Static.TfPlanInitial}" />
                            </StackPanel>
                        </Border>

                        <!-- 设备 + 读取内部容量：只属于内部存储的操作，TF 卡安装时整卡隐藏。 -->
                        <Border x:Name="InternalLayoutSection" Style="{StaticResource CardBorder}" Margin="0,20,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Static.CurrentDevice}" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="DeviceStripText"
                                                   Text="{DynamicResource Static.DeviceNotConfirmed}"
                                                   Style="{StaticResource BodyInkText}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="ReadLayoutButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Static.ReadLayout}"
                                            Click="OnReadLayout"
                                            IsEnabled="False"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="LayoutStatusText"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,10,0,0"
                                           Text="{DynamicResource Static.LayoutStatusInitial}" />
                            </StackPanel>
                        </Border>

                        <!-- 本地安装包（仅首次安装） -->
                        <Border x:Name="PackageSection" Style="{StaticResource CardBorder}" Margin="0,20,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.PackageTitle}" Style="{StaticResource H2Text}" />
                                <TextBlock Style="{StaticResource BodyText}"
                                           Margin="0,8,0,0"
                                           Text="{DynamicResource Static.PackageLead}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PackagePathBox"
                                             Grid.Column="0"
                                             Style="{StaticResource InputTextBox}"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnPackagePathChanged" />
                                    <Button x:Name="BrowsePackageButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Static.Browse}"
                                            Click="OnBrowsePackage"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" />
                                </Grid>
                                <Button x:Name="ValidatePackageButton"
                                        Content="{DynamicResource Static.ValidatePackage}"
                                        Click="OnValidatePackage"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0" />
                                <TextBlock x:Name="PackageStatusText"
                                           Style="{StaticResource BodyInkText}"
                                           Margin="0,10,0,0"
                                           Text="{DynamicResource Static.PackageUnchecked}" />
                            </StackPanel>
                        </Border>

                        <!-- 卸载所需输入（仅卸载 Linux） -->
                        <Border x:Name="UninstallInputSection" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.UninstallInputTitle}" Style="{StaticResource H2Text}" />
                                <TextBlock Style="{StaticResource BodyText}"
                                           Margin="0,8,0,0"
                                           Text="{DynamicResource Static.UninstallInputLead}" />

                                <!-- 主界面只保留「还原材料目录」：写入时既需要它，也用它核对每个槽位。 -->
                                <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.EdlRestore.Materials.Label}"
                                           Style="{StaticResource FieldLabelText}"
                                           Margin="0,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 原厂 boot 备份目录只经由「浏览…」选择。 -->
                                    <TextBox x:Name="StockBackupBox"
                                             Grid.Column="0"
                                             Style="{StaticResource InputTextBox}"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Center" />
                                    <Button x:Name="BrowseStockBackupButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Static.Browse}"
                                            Click="OnBrowseStockBackup"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" />
                                </Grid>
                                <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.EdlRestore.Materials.Hint}"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,6,0,0" />

                                <!-- 输出目录是必填项，但不在主界面重复放一个同源的输入框，只显示摘要与改路径入口。 -->
                                <Border Style="{StaticResource SoftPanel}" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.WorkRoot.SummaryLabel}"
                                                       Style="{StaticResource CaptionText}" />
                                            <TextBlock x:Name="UninstallWorkRootSummaryText"
                                                       Style="{StaticResource BodyInkText}"
                                                       FontSize="13"
                                                       Margin="0,4,0,0"
                                                       Text="{DynamicResource Dynamic.UninstallFlow.WorkRoot.SummaryInitial}" />
                                        </StackPanel>
                                        <Button x:Name="ChangeUninstallWorkRootButton"
                                                Grid.Column="1"
                                                Content="{DynamicResource Dynamic.UninstallFlow.WorkRoot.Change}"
                                                Click="OnBrowseUninstallWorkRoot"
                                                Style="{StaticResource GhostButton}"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0" />
                                    </Grid>
                                </Border>

                                <Button x:Name="PrepareUninstallButton"
                                        Content="{DynamicResource Dynamic.UninstallFlow.Input.PrepareButton}"
                                        Click="OnPrepareUninstall"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0" />

                                <TextBlock x:Name="UninstallInputNoteText"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,10,0,0"
                                           Text="{DynamicResource Dynamic.UninstallFlow.Input.NoteInitial}" />

                                <!-- 原始材料默认收起，避免一屏铺满；字段全部只读，只能经浏览选择。 -->
                                <Expander x:Name="RestoreAssetsExpander"
                                          Style="{StaticResource SectionExpander}"
                                          IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Asset.ExpanderHeader}"
                                                   Style="{StaticResource BodyInkText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <Border Style="{StaticResource SoftPanel}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Asset.PrimaryGpt}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       Margin="0,2,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OriginalPrimaryGptBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource InputTextBox}"
                                                         IsReadOnly="True"
                                                         VerticalContentAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource Static.Browse}"
                                                        Tag="primary-gpt"
                                                        Click="OnBrowseRestoreAsset"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="10,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Asset.BackupGpt}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       Margin="0,12,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OriginalBackupGptBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource InputTextBox}"
                                                         IsReadOnly="True"
                                                         VerticalContentAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource Static.Browse}"
                                                        Tag="backup-gpt"
                                                        Click="OnBrowseRestoreAsset"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="10,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Asset.BootA}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       Margin="0,12,0,6"
                                                       Visibility="Collapsed" />
                                            <Grid Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="StockBootAPathBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource InputTextBox}"
                                                         IsReadOnly="True"
                                                         VerticalContentAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource Static.Browse}"
                                                        Tag="boot-a"
                                                        Click="OnBrowseRestoreAsset"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="10,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Asset.BootB}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       Margin="0,12,0,6"
                                                       Visibility="Collapsed" />
                                            <Grid Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="StockBootBPathBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource InputTextBox}"
                                                         IsReadOnly="True"
                                                         VerticalContentAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource Static.Browse}"
                                                        Tag="boot-b"
                                                        Click="OnBrowseRestoreAsset"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="10,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Asset.Vbmeta}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       Margin="0,12,0,6"
                                                       Visibility="Collapsed" />
                                            <Grid Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="VbmetaBaselineBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource InputTextBox}"
                                                         IsReadOnly="True"
                                                         VerticalContentAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource Static.Browse}"
                                                        Tag="vbmeta-baseline"
                                                        Click="OnBrowseRestoreAsset"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="10,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.EdlRestore.AssetHint}"
                                                       Style="{StaticResource CaptionText}"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- 旧版安装记录保留在原处，只作为参考；原始分区表仍是必填。 -->
                                <Expander x:Name="LegacyRecordExpander"
                                          Style="{StaticResource SectionExpander}"
                                          IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.LegacyRecord.ExpanderHeader}"
                                                   Style="{StaticResource BodyInkText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <Border Style="{StaticResource SoftPanel}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Static.RecordLabel}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       Margin="0,2,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 只能通过「浏览…」写入：手改路径会让已读入的安装记录对象与框内文字不一致。 -->
                                                <TextBox x:Name="InstallationRecordBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource InputTextBox}"
                                                         IsReadOnly="True"
                                                         VerticalContentAlignment="Center" />
                                                <Button x:Name="BrowseInstallationRecordButton"
                                                        Grid.Column="1"
                                                        Content="{DynamicResource Static.Browse}"
                                                        Click="OnBrowseInstallationRecord"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="10,0,0,0" />
                                                <Button x:Name="ClearInstallationRecordButton"
                                                        Grid.Column="2"
                                                        Content="{DynamicResource Dynamic.UninstallFlow.Legacy.Clear}"
                                                        Click="OnClearLegacyInstallationRecord"
                                                        Style="{StaticResource GhostButton}"
                                                        IsEnabled="False"
                                                        Margin="10,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.LegacyRecord.Note}"
                                                       Style="{StaticResource CaptionText}"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- 首次安装的分配控件 -->
                        <Border x:Name="CapacityInstallPanel" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="CapacityTotalLabelText"
                                           Text="{DynamicResource Static.UserdataCapacity}"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="UserdataTotalText"
                                           Text="—"
                                           Style="{StaticResource MetricText}"
                                           Margin="0,2,0,0" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Android" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="AndroidBytesText"
                                                   Text="—"
                                                   Style="{StaticResource MetricText}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Linux" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="LinuxBytesText"
                                                   Text="—"
                                                   Style="{StaticResource MetricText}"
                                                   Foreground="{DynamicResource LinuxSegmentBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 真实比例的双色条：两列宽度按 AndroidBytes / LinuxBytes 的 star 值分配 -->
                                <Grid x:Name="RatioBar" Height="14" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="RatioAndroidColumn" Width="*" />
                                        <ColumnDefinition x:Name="RatioLinuxColumn" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="7,0,0,7" />
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource LinuxSegmentBrush}"
                                            CornerRadius="0,7,7,0" />
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CapacitySlider"
                                            Grid.Column="0"
                                            Style="{StaticResource CapacitySliderStyle}"
                                            IsEnabled="False"
                                            ValueChanged="OnCapacitySliderChanged" />
                                    <TextBox x:Name="CapacityBox"
                                             Grid.Column="1"
                                             Width="76"
                                             Style="{StaticResource InputTextBox}"
                                             IsEnabled="False"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnCapacityTextChanged"
                                             Margin="14,0,0,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="GiB"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0" />
                                </Grid>

                                <TextBlock x:Name="CapacityRuleText"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,10,0,0"
                                           Text="{DynamicResource Static.CapacityRuleInitial}" />
                                <TextBlock x:Name="CapacityNoteText"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,6,0,0"
                                           Text="{DynamicResource Static.CapacityNoteInitial}" />

                                <Button x:Name="DetailsToggle"
                                        Content="{DynamicResource Static.DetailsToggle}"
                                        Style="{StaticResource SectionToggle}"
                                        Click="OnToggleDetails" />
                                <Border x:Name="DetailsPanel" Style="{StaticResource SoftPanel}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.DetailUserdata}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailUserdataText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.DetailLinuxBoot}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailLinuxBootText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.DetailLinuxData}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailLinuxDataText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.DetailRange}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailRangeText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Static.DetailFingerprint}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailFingerprintText" Text="—" Style="{StaticResource FieldValueText}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 卸载 Linux：恢复安卓存储空间 -->
                        <Border x:Name="UninstallPanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.UninstallTitle}" Style="{StaticResource H2Text}" />
                                <TextBlock Style="{StaticResource BodyText}"
                                           Margin="0,8,0,0"
                                           Text="{DynamicResource Static.UninstallLead}" />

                                <TextBlock Text="{DynamicResource Static.RestoredCapacityLabel}" Style="{StaticResource CaptionText}" Margin="0,18,0,0" />
                                <TextBlock x:Name="RestoredCapacityText"
                                           Text="—"
                                           Style="{StaticResource MetricText}"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="RemovedRangeText"
                                           Style="{StaticResource BodyInkText}"
                                           Margin="0,10,0,0"
                                           Text="—" />
                                <TextBlock x:Name="UninstallPlanStatusText"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,8,0,0"
                                           Text="{DynamicResource Static.RecordNotChosen}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= 03 确认 ================= -->
                    <StackPanel x:Name="PageConfirm" Visibility="Collapsed">
                        <TextBlock x:Name="ConfirmTitleText" Text="{DynamicResource Static.ConfirmTitle}" Style="{StaticResource H1Text}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Margin="0,10,0,0"
                                   Text="{DynamicResource Static.ConfirmLead}" />

                        <!--
                            引导兼容性（所有模式都显示）：固件、Android 上报、路线判定与下一步。
                            单独一块小面板，只读渲染；不参与 4 种 SummaryText 的格式与提前返回，
                            换设备或清除设备后由 UpdateSummary 开头的同一次渲染刷新，不会留下旧值。
                        -->
                        <Border x:Name="ConfirmBootRoutePanel"
                                Style="{StaticResource CardBorder}"
                                Padding="16"
                                Margin="0,16,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.BootCompatTitle}" Style="{StaticResource H2Text}" />
                                <TextBlock x:Name="ConfirmBootRouteSourceText"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,6,0,0" />
                                <TextBlock x:Name="ConfirmFirmwareText"
                                           Style="{StaticResource BodyInkText}"
                                           FontSize="13"
                                           Margin="0,8,0,0" />
                                <TextBlock x:Name="ConfirmAndroidText"
                                           Style="{StaticResource BodyInkText}"
                                           FontSize="13"
                                           Margin="0,4,0,0" />
                                <TextBlock x:Name="ConfirmAndroidBootReportText"
                                           Style="{StaticResource BodyInkText}"
                                           FontSize="13"
                                           Margin="0,4,0,0" />
                                <TextBlock x:Name="ConfirmBootRouteStatusText"
                                           Style="{StaticResource BodyInkText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0" />
                                <TextBlock x:Name="ConfirmBootRouteNextStepText"
                                           Style="{StaticResource BodyText}"
                                           FontSize="12.5"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!--
                            卸载专用：设备操作状态。
                            与上面的引导兼容面板分开，只在卸载流程展开；状态文字只读，
                            刷新与验证都先禁用，等回调按真实结果启用。
                        -->
                        <Border x:Name="UninstallTransactionSection"
                                Style="{StaticResource CardBorder}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dynamic.UninstallFlow.Transaction.Title}"
                                           Style="{StaticResource H2Text}" />
                                <TextBlock x:Name="UninstallTransactionStatusText"
                                           Style="{StaticResource BodyInkText}"
                                           Margin="0,10,0,0"
                                           Text="{DynamicResource Dynamic.UninstallFlow.Transaction.StatusInitial}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="VerifyUninstallAndroidButton"
                                            Content="{DynamicResource Dynamic.UninstallFlow.Transaction.Verify}"
                                            Click="OnVerifyUninstallAndroid"
                                            Style="{StaticResource SecondaryButton}"
                                            IsEnabled="False"
                                            Margin="10,0,0,0" />
                                </WrapPanel>
                                <!-- 只说明后续步骤，不声称操作队列已经结束，也不提供重启按钮。 -->
                                <TextBlock x:Name="UninstallRecoveryNoteText"
                                           Text="{DynamicResource Dynamic.UninstallFlow.Transaction.RecoveryNote}"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- boot A/B 原始备份 -->
                        <Border x:Name="BootBackupSection" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.BootBackupTitle}" Style="{StaticResource H2Text}" />
                                <TextBlock x:Name="BootBackupStatusText"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,8,0,0"
                                           Text="{DynamicResource Static.BootBackupUnavailable}" />
                                <Button x:Name="BootBackupButton"
                                        Content="{DynamicResource Static.BootBackupButton}"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        ToolTip="{DynamicResource Static.BootBackupTooltip}" />
                            </StackPanel>
                        </Border>

                        <!-- 方案摘要 -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.SummaryTitle}" Style="{StaticResource H2Text}" />
                                <TextBlock x:Name="SummaryText"
                                           Style="{StaticResource BodyInkText}"
                                           Margin="0,10,0,0"
                                           Text="—" />
                            </StackPanel>
                        </Border>

                        <!-- 风险确认 -->
                        <Border x:Name="RiskSection" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.RiskTitle}" Style="{StaticResource H2Text}" />
                                <CheckBox x:Name="RiskCheck"
                                          Style="{StaticResource RiskCheckBox}"
                                          Margin="0,12,0,0"
                                          Checked="OnRiskChanged"
                                          Unchecked="OnRiskChanged">
                                    <TextBlock x:Name="RiskCheckText" TextWrapping="Wrap" FontSize="13" />
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- 状态与日志 -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.StatusTitle}" Style="{StaticResource H2Text}" />
                                <TextBlock x:Name="ProgressStatusText"
                                           Style="{StaticResource BodyInkText}"
                                           Margin="0,10,0,0"
                                           Text="{DynamicResource Static.ProgressWaiting}" />
                                <TextBlock x:Name="ActionReasonText"
                                           Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource WarnBrush}"
                                           Margin="0,6,0,0"
                                           Text="{DynamicResource Static.ActionDisabledReason}" />

                                <Button x:Name="LogToggle"
                                        Style="{StaticResource SectionToggle}"
                                        Click="OnToggleLog">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸"
                                                   Margin="0,0,4,0" />
                                        <TextBlock Text="{DynamicResource Static.LogToggle}" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="LogPanel" Style="{StaticResource SoftPanel}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="LogEmptyText"
                                                   Text="{DynamicResource Static.LogEmpty}"
                                                   Style="{StaticResource CaptionText}" />
                                        <ScrollViewer MaxHeight="180"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="LogList" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>

                    <!--
                        ================= 内部存储安装：四步专属向导 =================
                        只属于首页的「安装到内部存储」：按「连接检测 → 系统备份 → 分配空间 → 确认安装」
                        四页展开；共享检查 / 备份 / 输入 / 确认四个流程由各模式控制器接入。
                    -->
                    <Grid x:Name="InternalInstallPages" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ================= 01 连接检测 ================= -->
                        <StackPanel x:Name="InternalInstallCheckPage" Grid.Row="0">
                            <TextBlock Text="{DynamicResource Static.InternalInstall.Check.Title}" Style="{StaticResource H1Text}" />
                            <TextBlock x:Name="SharedDeviceCheckLead"
                                       Text="{DynamicResource Static.InternalInstall.Check.Lead}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource Static.Connection.Gen4UsbPortHint}"
                                       Style="{StaticResource BodyInkText}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <!-- 与旧连接页共用同一个 ConnectionGuide 实例，由代码在两组容器之间移动。 -->
                            <Border x:Name="InternalInstallGuideHost"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,8,0,0" />

                            <!-- TF 卡安装（读卡器路线）：第 0 步的读卡器卡片由代码移入此宿主。 -->
                            <Border x:Name="TfCardDiscoveryHost"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Visibility="Collapsed"
                                    Margin="0,8,0,0" />

                            <!--
                                多台设备时的串口选择：条目只来自真实 adb 列表，绝不预选第一项；
                                只有真的列出了设备时才显示并启用。单选设备无需在这里挑选。
                            -->
                            <TextBlock x:Name="InternalInstallDevicesLabel"
                                       Text="{DynamicResource Static.InternalInstall.Check.DeviceLabel}"
                                       Style="{StaticResource FieldLabelText}"
                                       Margin="0,14,0,6"
                                       Visibility="Collapsed" />
                            <ComboBox x:Name="InternalInstallDevicesCombo"
                                      Style="{StaticResource ThemeComboBox}"
                                      ItemContainerStyle="{StaticResource ThemeComboBoxItem}"
                                      SelectionChanged="OnInternalInstallDeviceSelected"
                                      AutomationProperties.Name="{DynamicResource Static.InternalInstall.Check.DeviceLabel}"
                                      IsEnabled="False"
                                      Visibility="Collapsed"
                                      Margin="0" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="InternalInstallCheckButton"
                                        Content="{DynamicResource Static.InternalInstall.Check.Button}"
                                        Click="OnCheckInternalInstallDevice"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False" />
                            </WrapPanel>

                            <!--
                                引导维护专用入口：仅维护模式显示。历史原厂备份只提供身份线索，
                                不代表当前安卓版本或解锁状态已确认；不在此处新增识别按钮或启动任何设备操作。
                            -->
                            <StackPanel x:Name="BootMaintenanceEntryPanel"
                                        Visibility="Collapsed"
                                        Margin="0,14,0,0">
                                <CheckBox x:Name="BootMaintenanceAlreadyEdlCheck"
                                          Style="{StaticResource RiskCheckBox}"
                                          Content="{DynamicResource Dynamic.BootMaintenance.AlreadyEdl}"
                                          Checked="OnBootMaintenanceEdlRouteChanged"
                                          Unchecked="OnBootMaintenanceEdlRouteChanged" />
                                <TextBlock x:Name="SharedEdlEntryHintText"
                                           Text="{DynamicResource Dynamic.BootMaintenance.EdlHint}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock x:Name="SharedEdlOriginalEntryLabel"
                                           Text="{DynamicResource Dynamic.BootMaintenance.OriginalSource}"
                                           Style="{StaticResource FieldLabelText}"
                                           Margin="0,12,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BootMaintenanceEntryOriginalBox"
                                             Grid.Column="0"
                                             Style="{StaticResource InputTextBox}"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Center" />
                                    <Button x:Name="BootMaintenanceEntryOriginalBrowseButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Static.Browse}"
                                            Click="OnBrowseBootMaintenanceOriginal"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" />
                                </Grid>

                                <!--
                                    高级：完整 Fastboot 核验入口（默认收起）。只有这个按钮的点击
                                    走原有完整检查；默认「检查平板」只读安卓身份，不发 Fastboot 命令。
                                -->
                                <Expander Style="{StaticResource SectionExpander}"
                                          IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource Dynamic.Shared.AdvancedCheckHeader}"
                                                   Style="{StaticResource BodyInkText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dynamic.Shared.AdvancedCheckWarning}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,6" />
                                        <Button x:Name="SharedFastbootCheckButton"
                                                Click="OnCheckInternalInstallDevice"
                                                Style="{StaticResource SecondaryButton}"
                                                IsEnabled="False"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <TextBlock x:Name="InternalInstallCheckProgressText"
                                       Style="{StaticResource BodyInkText}"
                                       Margin="0,12,0,0"
                                       Text="{DynamicResource Static.InternalInstall.Check.ProgressInitial}" />
                            <TextBlock x:Name="InternalInstallCheckStatusText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,0"
                                       Text="{DynamicResource Static.InternalInstall.Check.StatusInitial}" />

                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Check.FieldsTitle}"
                                               Style="{StaticResource H2Text}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.FieldModel}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InternalInstallModelText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.FieldSerial}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InternalInstallSerialText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.FieldFirmware}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InternalInstallFirmwareText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.FieldBootState}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InternalInstallBootloaderText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Field.Route}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InternalInstallRouteText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Field.Power}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InternalInstallPowerText" Text="—" Style="{StaticResource FieldValueText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= 02 系统备份 ================= -->
                        <StackPanel x:Name="InternalInstallBackupPage" Grid.Row="0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Title}" Style="{StaticResource H1Text}" />
                            <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Warning}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource WarnBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0" />

                            <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.FolderLabel}"
                                       Style="{StaticResource FieldLabelText}"
                                       Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InternalInstallBackupFolderBox"
                                         Grid.Column="0"
                                         Style="{StaticResource InputTextBox}"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                                <Button x:Name="InternalInstallBackupBrowseButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Static.Browse}"
                                        Click="OnBrowseInternalInstallBackupFolder"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="False"
                                        Margin="10,0,0,0" />
                            </Grid>

                            <!--
                                复用已有备份：勾选后只读取并校验用户指定的原始备份目录，
                                上方的电脑文件夹仍用于工具、方案输出与日志，父目录对两种模式都是必填。
                            -->
                            <CheckBox x:Name="InternalInstallBackupUseExistingCheck"
                                      Style="{StaticResource RiskCheckBox}"
                                      Margin="0,14,0,0"
                                      Checked="OnInternalInstallBackupUseExistingChanged"
                                      Unchecked="OnInternalInstallBackupUseExistingChanged">
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.UseExisting}"
                                           TextWrapping="Wrap"
                                           FontSize="13" />
                            </CheckBox>

                            <StackPanel x:Name="InternalInstallBackupExistingRow"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.ExistingFolderLabel}"
                                           Style="{StaticResource FieldLabelText}"
                                           Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InternalInstallBackupExistingFolderBox"
                                             Grid.Column="0"
                                             Style="{StaticResource InputTextBox}"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Center" />
                                    <Button x:Name="InternalInstallBackupExistingBrowseButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Static.Browse}"
                                            Click="OnBrowseInternalInstallBackupExistingFolder"
                                            Style="{StaticResource SecondaryButton}"
                                            IsEnabled="False"
                                            Margin="10,0,0,0" />
                                </Grid>
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.ExistingHint}"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="InternalInstallBackupButton"
                                        Click="OnBackupInternalInstall"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="InternalInstallBackupStartLabel"
                                                   Text="{DynamicResource Static.InternalInstall.Backup.StartButton}" />
                                        <TextBlock x:Name="InternalInstallBackupExistingLabel"
                                                   Text="{DynamicResource Dynamic.InternalInstall.Backup.ValidateExistingButton}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <ProgressBar x:Name="InternalInstallBackupProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         IsIndeterminate="False"
                                         Height="6"
                                         Margin="0,14,0,0" />

                            <TextBlock x:Name="InternalInstallBackupStatusText"
                                       Style="{StaticResource BodyInkText}"
                                       Margin="0,10,0,0"
                                       Text="{DynamicResource Static.InternalInstall.Backup.StatusInitial}" />
                            <TextBlock x:Name="InternalInstallBackupVerifiedText"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0"
                                       Text="{DynamicResource Static.InternalInstall.Backup.VerifiedInitial}" />

                            <!-- 只读的备份位置详情：目录、清单与清单摘要只在工厂实际返回备份后才填值。 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="InternalInstallBackupDetailTitle"
                                               Style="{StaticResource H2Text}" />
                                    <TextBlock x:Name="InternalInstallBackupFolderLabel"
                                               Style="{StaticResource FieldLabelText}"
                                               Margin="0,10,0,4" />
                                    <TextBlock x:Name="InternalInstallBackupDirectoryText"
                                               Style="{StaticResource FieldValueText}"
                                               TextWrapping="Wrap"
                                               Text="—" />
                                    <TextBlock x:Name="InternalInstallBackupManifestLabel"
                                               Style="{StaticResource FieldLabelText}"
                                               Margin="0,8,0,4" />
                                    <TextBlock x:Name="InternalInstallBackupManifestText"
                                               Style="{StaticResource FieldValueText}"
                                               TextWrapping="Wrap"
                                               Text="—" />
                                    <TextBlock x:Name="InternalInstallBackupManifestHashLabel"
                                               Style="{StaticResource FieldLabelText}"
                                               Margin="0,8,0,4" />
                                    <TextBlock x:Name="InternalInstallBackupManifestHashText"
                                               Style="{StaticResource FieldValueText}"
                                               TextWrapping="Wrap"
                                               Text="—" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.CoverageTitle}"
                                               Style="{StaticResource H2Text}" />
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Coverage}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= 03 分配空间 ================= -->
                        <StackPanel x:Name="InternalInstallCapacityPage" Grid.Row="0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.Title}" Style="{StaticResource H1Text}" />
                            <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.Lead}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,6,0,0" />

                            <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.PackageLabel}"
                                       Style="{StaticResource FieldLabelText}"
                                       Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InternalInstallPackageBox"
                                         Grid.Column="0"
                                         Style="{StaticResource InputTextBox}"
                                         IsEnabled="False"
                                         TextChanged="OnInternalInstallPackagePathChanged"
                                         VerticalContentAlignment="Center" />
                                <Button x:Name="InternalInstallPackageBrowseButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Static.Browse}"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OnBrowseInternalInstallPackage"
                                        IsEnabled="False"
                                        Margin="10,0,0,0" />
                                <Button x:Name="InternalInstallPackageValidateButton"
                                        Grid.Column="2"
                                        Content="{DynamicResource Static.ValidatePackage}"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OnValidateInternalInstallPackage"
                                        IsEnabled="False"
                                        Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="InternalInstallPackageStatusText"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,8,0,0"
                                       Text="{DynamicResource Static.InternalInstall.Capacity.PackageStatusInitial}" />

                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.CardTitle}"
                                               Style="{StaticResource H2Text}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Capacity.TotalLabel}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InternalInstallCapacityTotalText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Capacity.AndroidLabel}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InternalInstallCapacityAndroidText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Capacity.LinuxLabel}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InternalInstallCapacityLinuxText" Text="—" Style="{StaticResource FieldValueText}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Capacity.BackupFixedLabel}" Style="{StaticResource FieldLabelText}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{DynamicResource Static.InternalInstall.Capacity.BackupFixedValue}"
                                                   Style="{StaticResource FieldValueText}" />
                                    </Grid>

                                    <!-- 16 / 16 / 16 只是未测量时的占位几何，不代表设备已读到 16 GiB。 -->
                                    <Slider x:Name="InternalInstallCapacitySlider"
                                            Minimum="16"
                                            Maximum="16"
                                            Value="16"
                                            IsEnabled="False"
                                            ValueChanged="OnInternalInstallCapacityChanged"
                                            Margin="0,14,0,0" />

                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.Rule}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,10,0,0" />
                                    <TextBlock x:Name="InternalInstallCapacityStatusText"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,6,0,0"
                                               Text="{DynamicResource Static.InternalInstall.Capacity.StatusWaiting}" />
                                    <!-- 本页可见的准备进度：只在真实 Prepare 等待期间出现，没有百分比。 -->
                                    <ProgressBar x:Name="InternalInstallCapacityPreparationProgressBar"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 IsIndeterminate="False"
                                                 Visibility="Collapsed"
                                                 Height="6"
                                                 Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= 04 确认安装 ================= -->
                        <StackPanel x:Name="InternalInstallConfirmPage" Grid.Row="0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.Title}" Style="{StaticResource H1Text}" />
                            <TextBlock x:Name="InternalInstallConfirmLeadText"
                                       Text="{DynamicResource Static.InternalInstall.Confirm.Lead}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.Warning}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource WarnBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0" />

                            <!--
                                设备 / 系统包与引导：只显示本次真实读到的设备事实、已校验系统包
                                与已完成的 A/B 备份，不显示任何哈希，也不声称任何写入已完成。
                            -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.DeviceCardTitle}"
                                                   Style="{StaticResource H2Text}" />
                                        <TextBlock Text="{DynamicResource Static.FieldModel}"
                                                   Style="{StaticResource FieldLabelText}"
                                                   Margin="0,10,0,0" />
                                        <TextBlock x:Name="InternalInstallConfirmDeviceModelText"
                                                   Text="—"
                                                   Style="{StaticResource FieldValueText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,8" />
                                        <TextBlock Text="{DynamicResource Static.FieldSerial}"
                                                   Style="{StaticResource FieldLabelText}" />
                                        <TextBlock x:Name="InternalInstallConfirmDeviceSerialText"
                                                   Text="—"
                                                   Style="{StaticResource FieldValueText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,8" />
                                        <TextBlock Text="{DynamicResource Static.FieldFirmware}"
                                                   Style="{StaticResource FieldLabelText}" />
                                        <TextBlock x:Name="InternalInstallConfirmDeviceFirmwareText"
                                                   Text="—"
                                                   Style="{StaticResource FieldValueText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,8" />
                                        <TextBlock Text="{DynamicResource Static.FieldBootState}"
                                                   Style="{StaticResource FieldLabelText}" />
                                        <TextBlock x:Name="InternalInstallConfirmDeviceBootloaderText"
                                                   Text="—"
                                                   Style="{StaticResource FieldValueText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PackageCardTitle}"
                                                   Style="{StaticResource H2Text}" />
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PackageVersionLabel}"
                                                   Style="{StaticResource FieldLabelText}"
                                                   Margin="0,10,0,0" />
                                        <TextBlock x:Name="InternalInstallConfirmPackageVersionText"
                                                   Text="—"
                                                   Style="{StaticResource FieldValueText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,8" />
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PackageIdLabel}"
                                                   Style="{StaticResource FieldLabelText}" />
                                        <TextBlock x:Name="InternalInstallConfirmPackageIdText"
                                                   Text="—"
                                                   Style="{StaticResource FieldValueText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />

                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.BootBackupLabel}"
                                                   Style="{StaticResource FieldLabelText}"
                                                   Margin="0,14,0,0" />
                                        <TextBlock x:Name="InternalInstallConfirmBootBackupText"
                                                   Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Text="{DynamicResource Dynamic.InternalInstall.Confirm.BootPending}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 三列只显示方案对象里的真实分配结果；Linux 总计已经包含 Linux 启动区。 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.AllocationTitle}"
                                               Style="{StaticResource H2Text}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.AllocationAndroidLabel}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="InternalInstallConfirmAndroidText"
                                                       Text="—"
                                                       Style="{StaticResource FieldValueText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.AllocationLinuxLabel}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="InternalInstallConfirmLinuxText"
                                                       Text="—"
                                                       Style="{StaticResource FieldValueText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.AllocationBackupLabel}"
                                                       Style="{StaticResource FieldLabelText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="InternalInstallConfirmRecoveryText"
                                                       Text="—"
                                                       Style="{StaticResource FieldValueText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 电脑备份位置 / 进入 9008 前的电源记录：都是已有事实，不是实时读数。 -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.BackupCardTitle}"
                                                   Style="{StaticResource H2Text}" />
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.BackupPathLabel}"
                                                   Style="{StaticResource FieldLabelText}"
                                                   Margin="0,10,0,0" />
                                        <TextBlock x:Name="InternalInstallConfirmBackupPathText"
                                                   Text="—"
                                                   Style="{StaticResource FieldValueText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PowerCardTitle}"
                                                   Style="{StaticResource H2Text}" />
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PowerRecordLabel}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,10,0,0" />
                                        <TextBlock x:Name="InternalInstallConfirmPowerText"
                                                   Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Text="{DynamicResource Dynamic.InternalInstall.Power.Unknown}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--
                                只是用户自己的知情确认，不参与任何门槛，也不代表安装可执行：
                                只有真实方案、真实备份与有效系统包都在时才会由代码启用。
                            -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <CheckBox x:Name="InternalInstallEraseRiskCheck"
                                          Style="{StaticResource RiskCheckBox}"
                                          IsChecked="False"
                                          IsEnabled="False"
                                          Checked="OnInternalInstallEraseRiskChanged"
                                          Unchecked="OnInternalInstallEraseRiskChanged">
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.EraseRisk}"
                                               TextWrapping="Wrap"
                                               FontSize="13" />
                                </CheckBox>
                            </Border>

                            <!-- 原来的完整摘要（含全部哈希与工程目录）原样保留，只是默认收起。 -->
                            <Expander x:Name="InternalInstallVerificationDetails"
                                      Style="{StaticResource SectionExpander}"
                                      IsExpanded="False"
                                      Header="{DynamicResource Static.InternalInstall.Confirm.VerificationDetailsHeader}">
                                <TextBlock x:Name="InternalInstallSummaryText"
                                           Style="{StaticResource BodyInkText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="{DynamicResource Static.InternalInstall.Confirm.SummaryInitial}" />
                            </Expander>

                            <TextBlock x:Name="InternalInstallConfirmStatusText"
                                       Style="{StaticResource BodyInkText}"
                                       Margin="0,14,0,0"
                                       Text="{DynamicResource Static.InternalInstall.Confirm.StatusWaiting}" />
                            <ProgressBar x:Name="InternalInstallConfirmProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         IsIndeterminate="False"
                                         Height="6"
                                         Margin="0,10,0,0" />
                            <TextBlock x:Name="InternalInstallAcceptanceStatusText"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,0"
                                       Text="{DynamicResource Static.InternalInstall.Confirm.AcceptanceInitial}" />

                            <!--
                                写入完成后的只读复查与关闭助手：都由真实后端快照驱动，
                                默认收起；只有待验收或已进入终态时才由代码显示。
                            -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="InternalInstallAcceptanceRecheckButton"
                                        Content="{DynamicResource Dynamic.InternalInstall.Execution.RecheckButton}"
                                        Click="OnRecheckInternalInstallAcceptance"
                                        Style="{StaticResource SecondaryButton}"
                                        Visibility="Collapsed"
                                        IsEnabled="False" />
                                <Button x:Name="InternalInstallCloseAssistantButton"
                                        Content="{DynamicResource Dynamic.InternalInstall.Execution.CloseButton}"
                                        Click="OnCloseInternalInstallAssistant"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="10,0,0,0"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            四个内部页共用的唯一退出面板：只要真实 9008 会话（或未确认的进入尝试）
                            还在就显示。每种模式各自拥有真实重置，不存在基于 OS ADB 的完成门槛；
                            面板不新建窗口，也不在任何内部页里重复出现。
                        -->
                        <!-- ================= TF 卡安装 03 输入（安装包 + 目标卡） ================= -->
                        <StackPanel x:Name="TfInstallInputsPage" Grid.Row="0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Dynamic.TfInstall.Nav.Inputs}" Style="{StaticResource H1Text}" />
                            <Border x:Name="TfTabletStagePanel"
                                    Style="{StaticResource CardBorder}"
                                    Visibility="Collapsed"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TfTabletStageStatusText"
                                               Style="{StaticResource BodyText}"
                                               TextWrapping="Wrap" />
                                    <ProgressBar x:Name="TfTabletProgressBar" Height="8" Minimum="0" Maximum="100" Margin="0,8,0,0" />
                                    <TextBlock x:Name="TfTabletProgressText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="TfTabletRecoveryJournalText"
                                               Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <ComboBox x:Name="TfTabletPortsCombo" MinWidth="200" />
                                        <Button x:Name="TfTabletRefreshPortsButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="6,0,0,6"
                                                Content="{DynamicResource Dynamic.TfTablet.RefreshPorts}"
                                                Click="OnTfTabletRefreshPorts" />
                                        <Button x:Name="TfTabletConnectRamButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="6,0,0,6"
                                                Content="{DynamicResource Dynamic.TfTablet.ConnectRam}"
                                                Click="OnTfTabletConnectRam" />
                                        <Button x:Name="TfTabletPrepareCardButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="6,0,0,6"
                                                Content="{DynamicResource Dynamic.TfTablet.PrepareCard}"
                                                Click="OnTfTabletPrepareCard" />
                                        <Button x:Name="TfTabletSuspendButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="6,0,0,6"
                                                Content="{DynamicResource Dynamic.TfTablet.Suspend}"
                                                Click="OnTfTabletSuspend" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button x:Name="TfTabletPrepareFinalButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="6,0,0,6"
                                                Content="{DynamicResource Dynamic.TfTablet.PrepareFinal}"
                                                Click="OnTfTabletPrepareFinal" />
                                        <Button x:Name="TfTabletPrepareRestoreButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="6,0,0,6"
                                                Content="{DynamicResource Dynamic.TfTablet.PrepareRestore}"
                                                Click="OnTfTabletPrepareRestore" />
                                        <Button x:Name="TfTabletBrowseRecoveryButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="6,0,0,6"
                                                Content="{DynamicResource Dynamic.TfTablet.BrowseRecovery}"
                                                Click="OnTfTabletBrowseRecovery" />
                                    </WrapPanel>
                                    <CheckBox x:Name="TfTabletRiskCheck"
                                              Content="{DynamicResource Dynamic.TfTablet.RiskTemporary}"
                                              Margin="0,10,0,0"
                                              Checked="OnTfTabletRiskChanged"
                                              Unchecked="OnTfTabletRiskChanged" />
                                    <Button x:Name="TfTabletExecuteButton"
                                            Margin="0,12,0,0"
                                            Content="{DynamicResource Dynamic.TfTablet.Execute}"
                                            Click="OnTfTabletExecute" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="TfInstallPackageHost"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,8,0,0" />
                            <Border x:Name="TfInstallCardHost"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- ================= 引导维护 03 准备引导（维护专用） ================= -->
                        <StackPanel x:Name="BootMaintenanceSourcesPage" Grid.Row="0" Visibility="Collapsed">
                            <TextBlock x:Name="BootMaintenanceSourcesTitle"
                                       Text="{DynamicResource Dynamic.BootMaintenance.SourceTitle}"
                                       Style="{StaticResource H1Text}" />
                            <TextBlock x:Name="BootMaintenanceSourcesLead"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />

                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="SharedEdlOriginalSourceLabel"
                                               Text="{DynamicResource Dynamic.BootMaintenance.OriginalSource}"
                                               Style="{StaticResource FieldLabelText}"
                                               Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BootMaintenanceOriginalBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource InputTextBox}"
                                                 IsReadOnly="True"
                                                 VerticalContentAlignment="Center" />
                                        <Button x:Name="BootMaintenanceOriginalBrowseButton"
                                                Grid.Column="1"
                                                Content="{DynamicResource Static.Browse}"
                                                Click="OnBrowseBootMaintenanceOriginal"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="10,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.FreshBackup}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,6,0,0" />

                                    <!-- 修复模式专用：项目备份目录与系统安装包 -->
                                    <StackPanel x:Name="BootMaintenanceRepairSourcesRow"
                                                Visibility="Collapsed"
                                                Margin="0,14,0,0">
                                        <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.ProjectSource}"
                                                   Style="{StaticResource FieldLabelText}"
                                                   Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BootMaintenanceProjectBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource InputTextBox}"
                                                     IsReadOnly="True"
                                                     VerticalContentAlignment="Center" />
                                            <Button x:Name="BootMaintenanceProjectBrowseButton"
                                                    Grid.Column="1"
                                                    Content="{DynamicResource Static.Browse}"
                                                    Click="OnBrowseBootMaintenanceProject"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="10,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.Package}"
                                                   Style="{StaticResource FieldLabelText}"
                                                   Margin="0,12,0,6" />
                                        <TextBox x:Name="BootMaintenancePackageBox"
                                                 Style="{StaticResource InputTextBox}"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="OnBootMaintenancePackagePathChanged" />
                                        <TextBlock x:Name="BootMaintenancePackageHint"
                                                   Text="{DynamicResource Dynamic.BootMaintenance.PackageHint}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="BootMaintenancePrepareStatusText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap" />

                            <!--
                                下一步（全局底部 NextButton）稍后触发真实准备；不新增伪造的“立即准备”按钮。
                                备份父目录已在第 2 步选择，这里不重复出现全新备份文件夹控件。
                            -->
                        </StackPanel>

                        <!-- ================= 引导维护 04 确认操作（维护专用） ================= -->
                        <StackPanel x:Name="BootMaintenanceConfirmPage" Grid.Row="0" Visibility="Collapsed">
                            <TextBlock x:Name="BootMaintenanceConfirmTitle"
                                       Text="{DynamicResource Dynamic.BootMaintenance.ConfirmTitle}"
                                       Style="{StaticResource H1Text}" />
                            <TextBlock x:Name="BootMaintenanceDeviceText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="BootMaintenanceBackupLocationsText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />

                            <StackPanel x:Name="BootMaintenanceSlotsPanel" Margin="0,12,0,0" />

                            <Expander x:Name="BootMaintenanceRegionsPanel"
                                      Header="{DynamicResource Dynamic.BootMaintenance.RegionsTitle}"
                                      Style="{StaticResource SectionExpander}"
                                      Margin="0,12,0,0">
                                <StackPanel x:Name="BootMaintenanceRegionsHost" />
                            </Expander>

                            <CheckBox x:Name="BootMaintenanceRiskCheck"
                                      Style="{StaticResource RiskCheckBox}"
                                      Margin="0,14,0,0"
                                      Checked="OnBootMaintenanceRiskChanged"
                                      Unchecked="OnBootMaintenanceRiskChanged">
                                <TextBlock x:Name="BootMaintenanceRiskText"
                                           TextWrapping="Wrap"
                                           FontSize="13" />
                            </CheckBox>

                            <TextBlock x:Name="BootMaintenanceConfirmStatusText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="BootMaintenanceProgressText"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="BootMaintenanceProgressBar"
                                         Height="4"
                                         IsIndeterminate="False"
                                         Value="0"
                                         Minimum="0"
                                         Maximum="100"
                                         Margin="0,8,0,0" />
                        </StackPanel>

                        <Border x:Name="InternalInstallExitMaintenancePanel"
                                Grid.Row="1"
                                Style="{StaticResource CardBorder}"
                                Margin="0,16,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Exit.Title}"
                                           Style="{StaticResource H2Text}" />
                                <Button x:Name="InternalInstallExitMaintenanceButton"
                                        Content="{DynamicResource Dynamic.InternalInstall.Exit.Button}"
                                        Click="OnExitInternalInstallMaintenance"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="False"
                                        Margin="0,10,0,0" />
                                <TextBlock x:Name="InternalInstallExitMaintenanceStatusText"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="{DynamicResource Dynamic.InternalInstall.Exit.StatusIdle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <Expander x:Name="InternalInstallLogExpander"
                                      Style="{StaticResource SectionExpander}"
                                      Margin="0"
                                      IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Log.Title}"
                                                   Style="{StaticResource H2Text}" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                    <Setter Property="Text" Value="{DynamicResource Dynamic.InternalInstall.Log.Expand}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource Dynamic.InternalInstall.Log.Collapse}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Expander.Header>
                                <ScrollViewer x:Name="InternalInstallLogScrollViewer"
                                              Height="160"
                                              Margin="0,10,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock x:Name="InternalInstallLogEmptyText"
                                                   Text="{DynamicResource Dynamic.InternalInstall.Log.Empty}"
                                                   Style="{StaticResource CaptionText}" />
                                        <StackPanel x:Name="InternalInstallLogList" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Expander>
                        </Border>
                    </Grid>

                </Grid>
            </ScrollViewer>

            <!--
                ================= 运行环境与驱动准备 =================
                启动后先停在这一页：只做只读自检与显式安装随附驱动，准备完成后点「继续」才进入功能首页。
                页面里的状态文字全部来自控制器登记的本地化消息；可见性只由 ApplyFunctionView() 改。
            -->
            <ScrollViewer x:Name="EnvironmentPage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Static.Environment.Title}"
                               Style="{StaticResource H1Text}" />
                    <TextBlock Text="{DynamicResource Static.Environment.Lead}"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <!-- 四行状态：系统 / 运行组件 / 连接工具 / 驱动。圆点只是中性标记，不代表成功。 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{DynamicResource MutedBrush}"
                                        VerticalAlignment="Top"
                                        Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Environment.System}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="EnvironmentSystemStatusText"
                                               Text="{DynamicResource Dynamic.Environment.Checking}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{DynamicResource MutedBrush}"
                                        VerticalAlignment="Top"
                                        Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Environment.Runtime}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" />
                                    <!-- 运行组件随程序内置，没有可变的运行时状态字段。 -->
                                    <TextBlock Text="{DynamicResource Static.Environment.RuntimeIncluded}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{DynamicResource MutedBrush}"
                                        VerticalAlignment="Top"
                                        Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Environment.Tools}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="EnvironmentToolsStatusText"
                                               Text="{DynamicResource Dynamic.Environment.Checking}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{DynamicResource MutedBrush}"
                                        VerticalAlignment="Top"
                                        Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Environment.Driver}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="EnvironmentDriverStatusText"
                                               Text="{DynamicResource Dynamic.Environment.DriverState.Unknown}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <TextBlock x:Name="EnvironmentDriverVersionText"
                                               Text="{DynamicResource Dynamic.Environment.VersionUnknown}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 当前结论放在按钮之前：状态行与「下一步做什么」都取自控制器消息。 -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="EnvironmentStatusText"
                                               Text="{DynamicResource Dynamic.Environment.Checking}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Environment.Guide}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 英文或窄窗口时按钮自动换行，不挤压状态文字。 -->
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="EnvironmentCheckButton"
                                        Content="{DynamicResource Static.Environment.Check}"
                                        Click="OnEnvironmentCheck"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                                <Button x:Name="EnvironmentInstallDriverButton"
                                        Content="{DynamicResource Static.Environment.InstallDriver}"
                                        Click="OnEnvironmentInstall"
                                        Style="{StaticResource SecondaryButton}"
                                        Visibility="Collapsed"
                                        IsEnabled="False"
                                        Margin="0,0,8,8" />
                                <Button x:Name="EnvironmentContinueButton"
                                        Content="{DynamicResource Static.Environment.Continue}"
                                        Click="OnEnvironmentContinue"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="False"
                                        Margin="0,0,8,8" />
                            </WrapPanel>

                            <!-- 检查 / 安装记录默认收起，检查与安装期间也保持可展开、可滚动。 -->
                            <Expander Style="{StaticResource SectionExpander}"
                                      IsExpanded="False"
                                      Header="{DynamicResource Static.Environment.Details}"
                                      Margin="0,8,0,0">
                                <ScrollViewer Height="160"
                                              Margin="0,8,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="EnvironmentDetailsText"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--
                ================= 可选的 9008 全局备份 / 恢复（两个独立视图） =================
                环境准备通过后先到这里的「备份」视图，再进入功能首页；首页另有两张卡片分别进入
                「备份」与「恢复」视图。本页不是第七项操作：不备份可以直接跳过，也不写 _selectedOperation。
                进入时不做任何设备访问，连接必须由用户显式发起；连接、日志与进度为两个视图共用。
            -->
            <ScrollViewer x:Name="GlobalRecoveryPage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Padding="0,0,6,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <!--
                        标题与说明按视图切换：同一时刻只出现一套，绝不同时出现两个标题，
                        也不把备份说明留在恢复视图上。
                    -->
                    <TextBlock x:Name="GlobalBackupTitleText"
                               Text="{DynamicResource Static.Global.BackupTitle}"
                               Style="{StaticResource H1Text}" />
                    <TextBlock x:Name="GlobalRestoreTitleText"
                               Text="{DynamicResource Static.Global.RestoreTitle}"
                               Style="{StaticResource H1Text}"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="GlobalBackupLeadText"
                               Text="{DynamicResource Static.Global.BackupLead}"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="GlobalRestoreLeadText"
                               Text="{DynamicResource Static.Global.RestoreLead}"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="Collapsed" />

                    <!-- 只有环境准备完成后的可选页才说明可以跳过；首页入口不显示这句。 -->
                    <TextBlock x:Name="GlobalOptionalNoteText"
                               Text="{DynamicResource Static.Global.OptionalNote}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,6,0,0" />

                    <WrapPanel Margin="0,12,0,0">
                        <!-- 环境来源回环境准备页；首页来源回功能首页，两个返回按钮互斥显示。 -->
                        <Button x:Name="GlobalBackEnvironmentButton"
                                Content="{DynamicResource Static.Global.BackEnvironment}"
                                Click="OnGlobalBackEnvironment"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8" />
                        <Button x:Name="GlobalBackHomeButton"
                                Content="{DynamicResource Static.Global.BackHome}"
                                Click="OnGlobalBackEnvironment"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="Collapsed"
                                Margin="0,0,8,8" />
                        <Button x:Name="GlobalContinueButton"
                                Content="{DynamicResource Static.Global.Continue}"
                                Click="OnGlobalContinue"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,8" />
                    </WrapPanel>

                    <!-- 连接：型号由连接时自动识别，页面没有手动选择；进入本页不会自动访问设备。 -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.Global.AutoDetect}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />

                            <!-- 所有连接都由用户显式发起；已经处于 9008 时无需 Android。 -->
                            <WrapPanel Margin="0,0,0,10">
                                <Button x:Name="GlobalConnectButton"
                                        Content="{DynamicResource Static.Global.Connect}"
                                        Click="OnGlobalConnect"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>

                            <TextBlock x:Name="GlobalConnectionText"
                                       Text="{DynamicResource Dynamic.Global.Idle}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="GlobalPowerText"
                                       Text="{DynamicResource Static.Global.PowerInitial}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!--
                        公共保存位置：备份与恢复都要有工作记录目录，标签随视图切换，
                        因此恢复视图即使隐藏备份动作也仍然可以选目录。
                    -->
                    <Border x:Name="GlobalOutputSection" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="GlobalOutputBackupLabelText"
                                       Text="{DynamicResource Static.Global.BackupDirectoryLabel}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="GlobalOutputRestoreLabelText"
                                       Text="{DynamicResource Static.Global.OutputDirectoryLabelRestore}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GlobalBackupDirectoryBox"
                                         Style="{StaticResource InputTextBox}"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap" />
                                <Button x:Name="GlobalBrowseBackupButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Static.Global.Browse}"
                                        Click="OnGlobalBrowseBackup"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 视图 1：全局备份。说明与备份动作只在备份视图出现。 -->
                    <Border x:Name="GlobalBackupCard" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.Global.BackupBody}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="GlobalBackupButton"
                                        Content="{DynamicResource Static.Global.BackupButton}"
                                        Click="OnGlobalBackupAction"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="GlobalBackupSummaryText"
                                       Text="{DynamicResource Dynamic.Global.NoBackup}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 视图 2：全局恢复。必须绑定这台平板自己的完整备份，默认不显示。 -->
                    <Border x:Name="GlobalRestoreCard"
                            Style="{StaticResource CardBorder}"
                            Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.Global.RestoreBody}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Static.Global.RestoreDirectoryLabel}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GlobalRestoreDirectoryBox"
                                         Style="{StaticResource InputTextBox}"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap" />
                                <Button x:Name="GlobalBrowseRestoreButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Static.Global.Browse}"
                                        Click="OnGlobalBrowseRestore"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="GlobalPrepareRestoreButton"
                                        Content="{DynamicResource Static.Global.PrepareRestore}"
                                        Click="OnGlobalPrepareRestoreAction"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="GlobalRestoreSummaryText"
                                       Text="{DynamicResource Dynamic.Global.NoRestorePlan}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <CheckBox x:Name="GlobalRestoreConfirmCheck"
                                      Style="{StaticResource RiskCheckBox}"
                                      IsChecked="False"
                                      Checked="OnGlobalRestoreConsentChanged"
                                      Unchecked="OnGlobalRestoreConsentChanged"
                                      Margin="0,10,0,10">
                                <TextBlock Text="{DynamicResource Static.Global.RestoreConsent}"
                                           TextWrapping="Wrap"
                                           FontSize="13" />
                            </CheckBox>
                            <WrapPanel>
                                <Button x:Name="GlobalRestoreButton"
                                        Content="{DynamicResource Static.Global.RestoreButton}"
                                        Click="OnGlobalRestoreAction"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 公共进度与导航：不提供虚假的完成或成功状态。 -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="GlobalProgressStatusText"
                                       Text="{DynamicResource Dynamic.Global.Idle}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="GlobalProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Height="6"
                                         Margin="0,8,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="GlobalRestartButton"
                                        Content="{DynamicResource Static.Global.Restart}"
                                        Click="OnGlobalRestart"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="False"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 日志默认收起，操作期间也保持可折叠、可滚动。 -->
                    <Expander Style="{StaticResource SectionExpander}"
                              IsExpanded="False"
                              Header="{DynamicResource Static.Global.LogTitle}"
                              Margin="0,12,0,0">
                        <ScrollViewer x:Name="GlobalLogScrollViewer"
                                      Height="180"
                                      Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="GlobalLogEmptyText"
                                           Text="{DynamicResource Dynamic.Global.LogEmpty}"
                                           Style="{StaticResource CaptionText}" />
                                <StackPanel x:Name="GlobalLogList" />
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!--
                ================= 功能首页（应用入口） =================
                启动后先看到这一页：五张操作卡片各自对应一个独立操作，点击后进入原有向导；
                末尾两张 9008 卡片只打开全局页的备份 / 恢复视图，不参与这五种操作标签。
                TF 卡安装卡片暂时移除（底层实现保留），新安装入口因此不在这里出现。
                卡片内容全部取自本地化键（标题 16 半粗、说明 12 折行），图标是内联矢量 Path，
                不引入任何新库或图片资源。首页与向导的可见性只由 ApplyFunctionView() 改。
            -->
            <ScrollViewer x:Name="HomePage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Padding="0,0,6,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <!-- 首页标题右侧的入口只切回准备页，不是第七张功能卡片。 -->
                    <DockPanel>
                        <Button x:Name="HomeEnvironmentButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButton}"
                                Content="{DynamicResource Static.Environment.HomeLink}"
                                Click="OnShowEnvironment"
                                FontSize="11"
                                Padding="8,4"
                                VerticalAlignment="Top"
                                Margin="8,0,0,0" />
                        <TextBlock Text="{DynamicResource Static.HomeTitle}" Style="{StaticResource H1Text}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Static.HomeLead}"
                               Style="{StaticResource BodyText}"
                               Margin="0,6,0,0" />

                    <!-- 容器本身可整体禁用（查询进行中不允许换功能），卡片不各自管可用性。 -->
                    <Border x:Name="HomeCards"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,12,0,0">
                        <UniformGrid Columns="2" Margin="0">
                            <Button Tag="install"
                                    Click="OnSelectOperation"
                                    Style="{StaticResource FunctionCard}"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FunctionCardIcon}">
                                        <Path Data="M 7 2 H 17 V 22 H 7 Z M 10 19 H 14"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Static.Function.Install.Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Static.Function.Install.Desc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Tag="prepare"
                                    Click="OnSelectOperation"
                                    Style="{StaticResource FunctionCard}"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FunctionCardIcon}">
                                        <Path Data="M 12 3 V 15 M 7 10 L 12 15 L 17 10 M 4 20 H 20"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Static.Function.Prepare.Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Static.Function.Prepare.Desc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Tag="repair"
                                    Click="OnSelectOperation"
                                    Style="{StaticResource FunctionCard}"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FunctionCardIcon}">
                                        <Path Data="M 4 12 C 4 7.6 7.6 4 12 4 M 4 8 V 12 H 8 M 20 12 C 20 16.4 16.4 20 12 20 M 20 16 V 12 H 16"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Static.Function.Repair.Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Static.Function.Repair.Desc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Tag="restore"
                                    Click="OnSelectOperation"
                                    Style="{StaticResource FunctionCard}"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FunctionCardIcon}">
                                        <Path Data="M 5 10 H 14 C 17 10 17 16 14 16 H 9 M 5 10 L 9 6 M 5 10 L 9 14"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Static.Function.Restore.Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Static.Function.Restore.Desc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Tag="uninstall"
                                    Click="OnSelectOperation"
                                    Style="{StaticResource FunctionCard}"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FunctionCardIcon}">
                                        <Path Data="M 4 12 H 15 M 11 8 L 15 12 L 11 16 M 19 5 V 19"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Static.Function.Uninstall.Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Static.Function.Uninstall.Desc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!--
                                9008 全局备份 / 恢复：两张独立卡片，只切到全局页对应视图，
                                不写入五种功能的操作标签，也不进入任何安装向导。
                            -->
                            <Button Click="OnOpenGlobalBackupFromHome"
                                    Style="{StaticResource FunctionCard}"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FunctionCardIcon}">
                                        <Path Data="M 12 3 V 14 M 8 10 L 12 14 L 16 10 M 4 19 H 20"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Static.Function.GlobalBackup.Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Static.Function.GlobalBackup.Desc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Click="OnOpenGlobalRestoreFromHome"
                                    Style="{StaticResource FunctionCard}"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FunctionCardIcon}">
                                        <Path Data="M 12 15 V 4 M 8 8 L 12 4 L 16 8 M 4 19 H 20"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Static.Function.GlobalRestore.Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Static.Function.GlobalRestore.Desc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--
                ================= 支持项目（独立视图） =================
                与首页一样占满主体三列，默认收起；顶部按钮只在空闲时可点，返回后回到打开前的
                首页或向导（步骤、输入与已读到的状态都不重算）。全部文案走 Static.* 静态键，
                主题与语言切换后立即跟随。
                二维码图片是仓库里已有的原图，按原字节以 Resource 嵌入，这里只做等比缩放显示：
                不裁剪、不重绘、不改写像素，也不从网络加载；图片不附加点击，不打开任何支付链接。
            -->
            <ScrollViewer x:Name="SupportPage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0"
                          Margin="0,0,0,12"
                          Visibility="Collapsed">
                <StackPanel>
                    <!-- 返回：只切回原来的首页或向导，不发起查询、不清空输入。 -->
                    <Button x:Name="SupportBackButton"
                            Content="{DynamicResource Static.SupportBack}"
                            Style="{StaticResource GhostButton}"
                            Click="OnCloseSupport"
                            HorizontalAlignment="Left"
                            Padding="0,4"
                            Margin="0,0,0,8" />

                    <TextBlock Text="{DynamicResource Static.SupportTitle}" Style="{StaticResource H1Text}" />
                    <TextBlock Text="{DynamicResource Static.SupportLead}"
                               Style="{StaticResource BodyText}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource Static.SupportSponsor}"
                               Style="{StaticResource BodyText}"
                               Margin="0,10,0,0" />

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,16">
                        <StackPanel>
                            <!-- 原始宽高比显示：宽度随窗口收缩，最多 1000 DIP，且不放大超过原图尺寸。 -->
                            <Image Source="pack://application:,,,/Assets/sponsor-zh.png"
                                   MaxWidth="1000"
                                   Stretch="Uniform"
                                   StretchDirection="DownOnly"
                                   HorizontalAlignment="Left"
                                   AutomationProperties.Name="{DynamicResource Static.SupportQrAutomationName}" />

                            <TextBlock Text="{DynamicResource Static.SupportNote}"
                                       Style="{StaticResource BodyInkText}"
                                       FontWeight="SemiBold"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="{DynamicResource Static.SupportTail}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= 底栏：作者在左，免费声明居中，主操作在右 ================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 作者署名：第一行「作者 + 姓名」，第二行两个入口，保持最小排版。 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Static.AuthorLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <!-- 作者名只显示这一处：中文为「单翼」，英文为「danyi」，不追加任何账号后缀。 -->
                        <TextBlock Text="{DynamicResource Static.AuthorName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button x:Name="AuthorBilibiliButton"
                                Content="{DynamicResource Static.AuthorBilibili}"
                                Style="{StaticResource GhostButton}"
                                Click="OnOpenBilibili"
                                ToolTip="https://space.bilibili.com/258786"
                                FontSize="11"
                                Padding="0,2"
                                Margin="0"
                                HorizontalAlignment="Left" />
                        <Button x:Name="AuthorGithubButton"
                                Content="{DynamicResource Static.AuthorGithub}"
                                Style="{StaticResource GhostButton}"
                                Click="OnOpenGithub"
                                ToolTip="https://github.com/mydanyi"
                                FontSize="11"
                                Padding="0,2"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Background="{DynamicResource StrokeBrush}"
                        Margin="16,2" />

                <!-- 只显示短提示；完整说明保留在 ToolTip 里，不占版面。 -->
                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Static.FreeWarn}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           ToolTip="{DynamicResource Static.FreeWarnDetail}" />

                <!-- 首页：右侧只放一句提示；向导：右侧是「上一步 / 下一步 / 执行」。
                     两者占同一列，可见性由 ApplyFunctionView() 统一决定，作者与免费声明始终不动。 -->
                <TextBlock x:Name="HomeFooterHint"
                           Grid.Column="3"
                           Text="{DynamicResource Static.HomeFooterHint}"
                           FontSize="12.5"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />

                <StackPanel x:Name="WorkflowButtons"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="PrevButton"
                            Content="{DynamicResource Static.Previous}"
                            Click="OnPreviousPage"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="NextButton"
                            Content="{DynamicResource Static.Next}"
                            Click="OnNextPage"
                            Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" />
                    <Button x:Name="ActionButton"
                            Content="{DynamicResource Static.ActionInstall}"
                            Click="OnExecuteSelectedWorkflow"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
