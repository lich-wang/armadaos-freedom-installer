<UserControl x:Class="FreedomInstaller.App.ConnectionGuide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{DynamicResource Static.Guide.RegionName}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <!--
        连接图示（纯 UI 示意，不是平板真实截图，也不代表任何具体型号的系统界面）：
        三张原创矢量图分别说明「开发者选项 → USB 调试 → 连接授权」。

        约定：
        1. 颜色一律走 DynamicResource（Canvas / Surface / SurfaceAlt / Ink / Muted / Accent / AccentSoft /
           AccentInk / Stroke），语言和主题切换时文字与配色一起更新，不需要父窗口重建本控件。
        2. 所有文案都取 Static.Guide.* 键，中文 / 英文索引一一对应。
        3. 动画只作用在本文件里的局部元素（不透明度、位移、缩放），不动任何主题笔刷；
           动画在代码里以可控 Storyboard 启动，切图 / 隐藏 / 卸载前移除时钟，静止姿态即最终高亮姿态。
        4. Viewbox 只包住矢量场景；文字标题、说明和按钮留在它外面，保证字号可读。
    -->

    <UserControl.Resources>

        <!-- ===== 步骤胶囊（1 / 2 / 3） ===== -->
        <Style x:Key="GuideChip" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ChipChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 上一张 / 下一张 / 重播：本控件自带样式，标签与主流程「下一步」区分 ===== -->
        <Style x:Key="GuidePictureButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Setter TargetName="NavChrome" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 文字（Viewbox 之外，字号固定可读） ===== -->
        <Style x:Key="GuideCaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>

        <Style x:Key="GuideNoteText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="GuideCounterText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== 图内文字 ===== -->
        <Style x:Key="SceneRowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SceneRowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= 步骤胶囊 ================= -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,2">
                <ToggleButton x:Name="DeveloperChip"
                              Style="{StaticResource GuideChip}"
                              Content="{DynamicResource Static.Guide.ChipDeveloper}"
                              AutomationProperties.Name="{DynamicResource Static.Guide.ChipDeveloper}"
                              Click="OnDeveloperChipClick" />
                <ToggleButton x:Name="UsbDebugChip"
                              Style="{StaticResource GuideChip}"
                              Content="{DynamicResource Static.Guide.ChipUsbDebug}"
                              AutomationProperties.Name="{DynamicResource Static.Guide.ChipUsbDebug}"
                              Click="OnUsbDebugChipClick" />
                <ToggleButton x:Name="AuthorizeChip"
                              Style="{StaticResource GuideChip}"
                              Content="{DynamicResource Static.Guide.ChipAuthorize}"
                              AutomationProperties.Name="{DynamicResource Static.Guide.ChipAuthorize}"
                              Click="OnAuthorizeChipClick" />
            </WrapPanel>

            <!-- ================= 矢量场景（Viewbox 只包住这一块） ================= -->
            <Border Grid.Row="1"
                    Height="214"
                    Margin="0,2,0,0"
                    Background="{DynamicResource CanvasBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="4"
                    ClipToBounds="True">
                <Viewbox Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Grid Width="680" Height="220">

                        <!-- ========== 图 1：关于平板 → 连续点「版本号」7 次 ========== -->
                        <Canvas x:Name="Scene1"
                                Width="680"
                                Height="220"
                                IsHitTestVisible="False">

                            <Border Canvas.Left="170"
                                    Canvas.Top="14"
                                    Width="340"
                                    Height="192"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="2"
                                    CornerRadius="16">
                                <Grid Margin="12,9,12,9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                                        <Path Data="M 6 0 L 0 5 L 6 10"
                                              Stroke="{DynamicResource MutedBrush}"
                                              StrokeThickness="1.6"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Static.Guide.Settings}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧菜单：中性条 + 高亮的「关于平板」 -->
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="8"
                                                Padding="7,8">
                                            <StackPanel>
                                                <Border Height="7" CornerRadius="3.5" Background="{DynamicResource StrokeBrush}" Margin="0,2,18,8" />
                                                <Border Height="7" CornerRadius="3.5" Background="{DynamicResource StrokeBrush}" Margin="0,0,26,8" />
                                                <Border Height="7" CornerRadius="3.5" Background="{DynamicResource StrokeBrush}" Margin="0,0,14,10" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="6,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="3"
                                                                CornerRadius="1.5"
                                                                Background="{DynamicResource AccentBrush}"
                                                                Margin="0,0,6,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{DynamicResource Static.Guide.AboutTablet}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource InkBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- 右侧详情：设备名称 / Android 版本 / 版本号 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <TextBlock Text="{DynamicResource Static.Guide.AboutTablet}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       Margin="2,0,0,10" />

                                            <Grid Margin="2,0,2,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource Static.Guide.DeviceName}" Style="{StaticResource SceneRowLabel}" />
                                                <TextBlock Grid.Column="1" Text="—" Style="{StaticResource SceneRowValue}" />
                                            </Grid>

                                            <Grid Margin="2,0,2,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource Static.Guide.AndroidVersion}" Style="{StaticResource SceneRowLabel}" />
                                                <TextBlock Grid.Column="1" Text="—" Style="{StaticResource SceneRowValue}" />
                                            </Grid>

                                            <!-- 版本号：强调矩形 + ×7 徽标 + 七次脉冲的点击环 -->
                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="9"
                                                    Padding="8,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{DynamicResource Static.Guide.BuildNumber}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="—"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <Border x:Name="Scene1TapRing"
                                                            Grid.Column="2"
                                                            Width="30"
                                                            Height="30"
                                                            CornerRadius="15"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource AccentBrush}"
                                                            BorderThickness="2"
                                                            Opacity="0.9"
                                                            VerticalAlignment="Center">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform x:Name="Scene1TapRingScale"
                                                                            ScaleX="1"
                                                                            ScaleY="1"
                                                                            CenterX="15"
                                                                            CenterY="15" />
                                                        </Border.RenderTransform>
                                                        <TextBlock Text="{DynamicResource Static.Guide.SevenTimes}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource InkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Canvas>

                        <!-- ========== 图 2：开发者选项 → 打开「USB 调试」 ========== -->
                        <Canvas x:Name="Scene2"
                                Width="680"
                                Height="220"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">

                            <Border Canvas.Left="170"
                                    Canvas.Top="14"
                                    Width="340"
                                    Height="192"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="2"
                                    CornerRadius="16">
                                <Grid Margin="12,9,12,9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                                        <Path Data="M 6 0 L 0 5 L 6 10"
                                              Stroke="{DynamicResource MutedBrush}"
                                              StrokeThickness="1.6"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Static.Guide.DevOptions}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">
                                        <Border Height="7" Width="96" CornerRadius="3.5" Background="{DynamicResource StrokeBrush}" HorizontalAlignment="Left" Margin="2,2,0,10" />
                                        <Border Height="7" Width="128" CornerRadius="3.5" Background="{DynamicResource StrokeBrush}" HorizontalAlignment="Left" Margin="2,0,0,10" />

                                        <!-- USB 调试：放大 + 高亮的行，右侧开关由关到开只动一次 -->
                                        <Border Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="10"
                                                Padding="10,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Static.Guide.UsbDebugRow}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                    <Border Height="6"
                                                            Width="86"
                                                            CornerRadius="3"
                                                            Background="{DynamicResource StrokeBrush}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,7,0,0" />
                                                </StackPanel>

                                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <!-- 点击提示环（只做不透明度脉冲） -->
                                                    <Border x:Name="Scene2TapCue"
                                                            Width="58"
                                                            Height="38"
                                                            CornerRadius="19"
                                                            BorderBrush="{DynamicResource AccentBrush}"
                                                            BorderThickness="2"
                                                            Opacity="0.9" />

                                                    <Grid Width="44" Height="24">
                                                        <Border CornerRadius="12"
                                                                Background="{DynamicResource SurfaceAltBrush}"
                                                                BorderBrush="{DynamicResource StrokeBrush}"
                                                                BorderThickness="1" />
                                                        <Border x:Name="Scene2SwitchOn"
                                                                CornerRadius="12"
                                                                Background="{DynamicResource AccentBrush}"
                                                                Opacity="1" />
                                                        <Ellipse x:Name="Scene2SwitchKnob"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Fill="{DynamicResource SurfaceBrush}"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center"
                                                                 Margin="3,0,0,0">
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform x:Name="Scene2KnobShift" X="20" />
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Border Height="7" Width="112" CornerRadius="3.5" Background="{DynamicResource StrokeBrush}" HorizontalAlignment="Left" Margin="2,10,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Canvas>

                        <!-- ========== 图 3：USB 线连接电脑 → 平板弹窗点「允许」 ========== -->
                        <Canvas x:Name="Scene3"
                                Width="680"
                                Height="220"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">

                            <!-- 笔记本电脑（矢量示意） -->
                            <Border Canvas.Left="26"
                                    Canvas.Top="44"
                                    Width="152"
                                    Height="88"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6">
                                <StackPanel Margin="9,8" VerticalAlignment="Top">
                                    <Border Height="6" Width="64" CornerRadius="3" Background="{DynamicResource StrokeBrush}" HorizontalAlignment="Left" />
                                    <Border Height="6" Width="46" CornerRadius="3" Background="{DynamicResource StrokeBrush}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    <Border Height="6" Width="56" CornerRadius="3" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Path Canvas.Left="10"
                                  Canvas.Top="136"
                                  Width="184"
                                  Height="14"
                                  Data="M 18 0 L 166 0 L 184 14 L 0 14 Z"
                                  Fill="{DynamicResource SurfaceAltBrush}"
                                  Stroke="{DynamicResource StrokeBrush}"
                                  StrokeThickness="1.5" />

                            <!-- USB 线：从平板底部插头向下，再向左接回电脑 -->
                            <Path Data="M 493 183 L 493 197 Q 493 206 484 206 L 224 206 Q 206 206 206 188 L 206 117 L 194 117"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="3.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent" />

                            <!-- 电脑侧插头 -->
                            <Border Canvas.Left="178" Canvas.Top="110" Width="16" Height="14" CornerRadius="4"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1.5" />

                            <TextBlock Canvas.Left="26" Canvas.Top="158"
                                       Width="152"
                                       Text="{DynamicResource Static.Guide.ConnectComputer}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />

                            <!-- 横放的 Y700 平板：底部中央是 USB-C 口 -->
                            <Border Canvas.Left="326"
                                    Canvas.Top="8"
                                    Width="334"
                                    Height="156"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="2"
                                    CornerRadius="13">
                                <Grid>
                                    <Border Margin="6"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="8"
                                            BorderBrush="{DynamicResource StrokeBrush}"
                                            BorderThickness="1" />

                                    <!-- 顶部边框中央的小摄像头 -->
                                    <Ellipse Width="5" Height="5"
                                             Fill="{DynamicResource StrokeBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top"
                                             Margin="0,1,0,0" />

                                    <!-- 唯一的 USB 调试授权弹窗（装饰性矢量，不是真实按钮） -->
                                    <Border Margin="18,20"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="9"
                                            Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Static.Guide.AuthDialogTitle}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       TextWrapping="Wrap" />

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Width="13"
                                                        Height="13"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center">
                                                    <Path Data="M 0 3 L 2.4 5.5 L 6.4 1"
                                                          Stroke="{DynamicResource AccentInkBrush}"
                                                          StrokeThickness="1.6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{DynamicResource Static.Guide.AuthAlways}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="6,0,0,0"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource StrokeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="11,4">
                                                    <TextBlock Text="{DynamicResource Static.Guide.AuthCancel}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                </Border>

                                                <Grid Margin="8,0,0,0">
                                                    <Border x:Name="Scene3TapCue"
                                                            CornerRadius="9"
                                                            BorderBrush="{DynamicResource AccentBrush}"
                                                            BorderThickness="2"
                                                            Margin="-5"
                                                            Opacity="0.9" />
                                                    <Border Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="6"
                                                            Padding="15,5">
                                                        <TextBlock Text="{DynamicResource Static.Guide.AuthAllow}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentInkBrush}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 底部长边中央：高亮 USB-C 接口（水平圆角槽） -->
                            <Border Canvas.Left="477" Canvas.Top="152" Width="32" Height="20" CornerRadius="10"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Opacity="0.9" />
                            <Border Canvas.Left="483" Canvas.Top="159" Width="20" Height="10" CornerRadius="5"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2" />

                            <!-- 插头竖直向上插入底边接口，线从插头底部向下再向左 -->
                            <Border Canvas.Left="489" Canvas.Top="164" Width="8" Height="7" CornerRadius="2"
                                    Background="{DynamicResource StrokeBrush}" />
                            <Border Canvas.Left="485" Canvas.Top="168" Width="16" Height="16" CornerRadius="4"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1.5" />

                            <!-- 长边接口标注：引线与箭头精确指向底部接口 -->
                            <Path Data="M 516 182 L 508 170 L 497 165"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent" />
                            <Path Data="M 495 164 L 503 165 L 499 171 Z"
                                  Fill="{DynamicResource AccentBrush}" />

                            <Border Canvas.Left="512" Canvas.Top="176" Width="150"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="7"
                                    Padding="7,5">
                                <TextBlock Text="{DynamicResource Static.Guide.LongEdgeUsbC}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Canvas>

                    </Grid>
                </Viewbox>
            </Border>

            <!-- ================= 一句说明（随步骤切换） ================= -->
            <Grid Grid.Row="2" Margin="2,10,2,0">
                <TextBlock x:Name="GuideCaption1"
                           Style="{StaticResource GuideCaptionText}"
                           Text="{DynamicResource Static.Guide.Step1Caption}"
                           AutomationProperties.Name="{DynamicResource Static.Guide.Step1Caption}" />
                <TextBlock x:Name="GuideCaption2"
                           Style="{StaticResource GuideCaptionText}"
                           Text="{DynamicResource Static.Guide.Step2Caption}"
                           Visibility="Collapsed"
                           AutomationProperties.Name="{DynamicResource Static.Guide.Step2Caption}" />
                <TextBlock x:Name="GuideCaption3"
                           Style="{StaticResource GuideCaptionText}"
                           Text="{DynamicResource Static.Guide.Step3Caption}"
                           Visibility="Collapsed"
                           AutomationProperties.Name="{DynamicResource Static.Guide.Step3Caption}" />
            </Grid>

            <!-- ================= 常驻提示 ================= -->
            <TextBlock Grid.Row="3"
                       Style="{StaticResource GuideNoteText}"
                       Text="{DynamicResource Static.Guide.Note}"
                       AutomationProperties.Name="{DynamicResource Static.Guide.Note}"
                       Margin="2,6,2,0" />

            <!-- ================= 翻图 / 重播 ================= -->
            <Grid Grid.Row="4" Margin="2,12,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviousPictureButton"
                            Style="{StaticResource GuidePictureButton}"
                            Content="{DynamicResource Static.Guide.PrevPicture}"
                            AutomationProperties.Name="{DynamicResource Static.Guide.PrevPicture}"
                            Click="OnPreviousPictureClick" />
                    <TextBlock x:Name="GuideCounter"
                               Style="{StaticResource GuideCounterText}"
                               Text="1 / 3"
                               Margin="10,0,10,0" />
                    <Button x:Name="NextPictureButton"
                            Style="{StaticResource GuidePictureButton}"
                            Content="{DynamicResource Static.Guide.NextPicture}"
                            AutomationProperties.Name="{DynamicResource Static.Guide.NextPicture}"
                            Click="OnNextPictureClick" />
                </StackPanel>

                <Button x:Name="ReplayButton"
                        Grid.Column="1"
                        Style="{StaticResource GuidePictureButton}"
                        Content="{DynamicResource Static.Guide.Replay}"
                        AutomationProperties.Name="{DynamicResource Static.Guide.Replay}"
                        Foreground="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center"
                        Click="OnReplayClick" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
