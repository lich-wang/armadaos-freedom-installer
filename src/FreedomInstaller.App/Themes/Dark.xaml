<!--
    深色主题调色板。

    约定：本文件的键名集合与 Themes/Light.xaml 完全一致（typed Color + 对应 SolidColorBrush 成对出现）。
    深处用 #17191D 画布配 #22252A 表面，强调色换成 #B8E46B（配深色文字），Linux 条段保持 #8FB6D2。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== typed 颜色 ===== -->
    <Color x:Key="CanvasColor">#17191D</Color>
    <Color x:Key="SurfaceColor">#22252A</Color>
    <Color x:Key="SurfaceAltColor">#1B1E22</Color>
    <Color x:Key="InkColor">#F3F4F6</Color>
    <Color x:Key="MutedColor">#A1A6B0</Color>
    <Color x:Key="AccentColor">#B8E46B</Color>
    <Color x:Key="AccentHoverColor">#C9ED8A</Color>
    <Color x:Key="AccentInkColor">#10130A</Color>
    <Color x:Key="AccentSoftColor">#2A3320</Color>
    <Color x:Key="LinuxSegmentColor">#8FB6D2</Color>
    <Color x:Key="StrokeColor">#363A42</Color>
    <Color x:Key="WarnColor">#E3B341</Color>
    <Color x:Key="DangerColor">#F07178</Color>
    <Color x:Key="HoverColor">#2B2F35</Color>
    <Color x:Key="SelectedColor">#2E3525</Color>
    <Color x:Key="FocusColor">#B8E46B</Color>
    <Color x:Key="ScrollThumbColor">#4A4F58</Color>

    <!-- ===== 画布 / 表面 ===== -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#17191D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#22252A" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B1E22" />

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="InkBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A1A6B0" />

    <!-- ===== 强调色 ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#B8E46B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C9ED8A" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#10130A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A3320" />
    <SolidColorBrush x:Key="LinuxSegmentBrush" Color="#8FB6D2" />

    <!-- ===== 边框 / 状态 ===== -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#363A42" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E3B341" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F07178" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2B2F35" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#2E3525" />
    <SolidColorBrush x:Key="FocusBrush" Color="#B8E46B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4F58" />

</ResourceDictionary>
