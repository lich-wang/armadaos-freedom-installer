<!--
    浅色主题调色板。

    约定：本文件的键名集合与 Themes/Dark.xaml 完全一致（typed Color + 对应 SolidColorBrush 成对出现），
    界面里的每一个刷色都通过 DynamicResource 引用这里的键，切换主题时只替换整份字典，
    所以按钮、边框、输入框、下拉列表、日志行会一起变色。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== typed 颜色 ===== -->
    <Color x:Key="CanvasColor">#F5F6FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EFF1F6</Color>
    <Color x:Key="InkColor">#111827</Color>
    <Color x:Key="MutedColor">#6B7280</Color>
    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentHoverColor">#4F46E5</Color>
    <Color x:Key="AccentInkColor">#FFFFFF</Color>
    <Color x:Key="AccentSoftColor">#ECEEFE</Color>
    <Color x:Key="LinuxSegmentColor">#8FB6D2</Color>
    <Color x:Key="StrokeColor">#E4E7EF</Color>
    <Color x:Key="WarnColor">#B45309</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="HoverColor">#EEF0F6</Color>
    <Color x:Key="SelectedColor">#E5E8FB</Color>
    <Color x:Key="FocusColor">#6366F1</Color>
    <Color x:Key="ScrollThumbColor">#C7CCD8</Color>

    <!-- ===== 画布 / 表面 ===== -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F6FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EFF1F6" />

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="InkBrush" Color="#111827" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />

    <!-- ===== 强调色 ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECEEFE" />
    <SolidColorBrush x:Key="LinuxSegmentBrush" Color="#8FB6D2" />

    <!-- ===== 边框 / 状态 ===== -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#E4E7EF" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B45309" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF0F6" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E5E8FB" />
    <SolidColorBrush x:Key="FocusBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C7CCD8" />

</ResourceDictionary>
