<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command line front end of the internal install for macOS (and other non-Windows hosts). It drives the
       same FreedomInstaller.Core calls in the same order as the WPF pages; the native tools (edl-ng, the boot
       packers, adb/fastboot) and the EDL archive are passed as explicit paths. Build with
       -p:BundledAvbSigningKey=<abs path> like the other projects, so Core embeds the AVB test key. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FreedomInstaller.Cli</RootNamespace>
    <AssemblyName>freedom-installer</AssemblyName>
    <Version>0.7.6</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreedomInstaller.Core\FreedomInstaller.Core.csproj" />
  </ItemGroup>

</Project>
