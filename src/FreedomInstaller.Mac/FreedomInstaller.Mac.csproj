<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS window front end of the internal install. Same pages, palette, styles and text catalogs as
       FreedomInstaller.App (WPF), drawn with Avalonia because WPF only runs on Windows. Every decision and
       check stays in FreedomInstaller.Core; the pages drive the same Core calls in the same order as the
       WPF pages. Release builds come from maintenance/build_installer_macos.py, which compiles the macOS tools,
       generates their pins and passes everything through BundledBuildInputsProps. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FreedomInstaller.Mac</RootNamespace>
    <AssemblyName>FreedomInstaller.Mac</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <Authors>danyi (mydanyi)</Authors>
    <Product>ArmadaOS Freedom 安装助手</Product>
    <!-- Installer-only opt-in: see FreedomInstaller.App.csproj. SDK appends the real SourceRevisionId to AssemblyInformationalVersion when available. Shared Directory.Build.props keeps this off for every other project. -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreedomInstaller.Core\FreedomInstaller.Core.csproj" />
  </ItemGroup>

  <!-- The WPF window's text catalog code and both catalogs, shared as files so both front ends show the same
       words. Mac.*.json only adds the few lines that name the Mac host instead of Windows. -->
  <ItemGroup>
    <Compile Include="..\FreedomInstaller.App\UiText.cs" Link="Shared\UiText.cs" />
    <!-- The offline upgrade page's window-free state helpers, shared as files so both front ends gate the same
         buttons, list the same saved sessions and accept the same recovery bundles. -->
    <Compile Include="..\FreedomInstaller.App\OfflineUpdateConnectionUiState.cs" Link="Shared\OfflineUpdateConnectionUiState.cs" />
    <Compile Include="..\FreedomInstaller.App\OfflineUpdateUiState.cs" Link="Shared\OfflineUpdateUiState.cs" />
    <Compile Include="..\FreedomInstaller.App\OfflineUpdateSessionCatalog.cs" Link="Shared\OfflineUpdateSessionCatalog.cs" />
    <Compile Include="..\FreedomInstaller.App\OfflineUpdateRecoveryCatalog.cs" Link="Shared\OfflineUpdateRecoveryCatalog.cs" />
    <Compile Include="..\FreedomInstaller.App\OfflineBootstrapAssets.cs" Link="Shared\OfflineBootstrapAssets.cs" />
    <EmbeddedResource Include="..\FreedomInstaller.App\Resources\Static.*.json"
                      Link="Shared\Resources\%(Filename)%(Extension)"
                      LogicalName="FreedomInstaller.Strings.%(Filename).json"
                      WithCulture="false" />
    <EmbeddedResource Include="..\FreedomInstaller.App\Resources\Dynamic.*.json"
                      Link="Shared\Resources\%(Filename)%(Extension)"
                      LogicalName="FreedomInstaller.Strings.%(Filename).json"
                      WithCulture="false" />
    <EmbeddedResource Include="Resources\Mac.*.json"
                      LogicalName="FreedomInstaller.Strings.%(Filename).json"
                      WithCulture="false" />
  </ItemGroup>

  <!-- Bundled tools, embedded only when the build supplies existing files, under the same logical names the WPF
       installer uses. On macOS they are the macos-arm64 EDL archives (edl-ng + libusb) and the universal boot
       packers made by build_installer_macos.py; nothing is downloaded here. -->
  <ItemGroup Condition="'$(BundledEdlTb710fuArchive)' != '' and Exists('$(BundledEdlTb710fuArchive)')">
    <EmbeddedResource Include="$(BundledEdlTb710fuArchive)" LogicalName="FreedomInstaller.EdlTools.TB710FU.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledEdlArchive)' != '' and Exists('$(BundledEdlArchive)')">
    <EmbeddedResource Include="$(BundledEdlArchive)" LogicalName="FreedomInstaller.EdlTools.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledEdlG5Archive)' != '' and Exists('$(BundledEdlG5Archive)')">
    <EmbeddedResource Include="$(BundledEdlG5Archive)" LogicalName="FreedomInstaller.EdlTools.G5.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledEdlRawPacker)' != '' and Exists('$(BundledEdlRawPacker)')">
    <EmbeddedResource Include="$(BundledEdlRawPacker)" LogicalName="FreedomInstaller.EdlRawPacker.exe" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledEdlRawUnpacker)' != '' and Exists('$(BundledEdlRawUnpacker)')">
    <EmbeddedResource Include="$(BundledEdlRawUnpacker)" LogicalName="FreedomInstaller.EdlRawUnpacker.exe" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledPlatformToolsArchive)' != '' and Exists('$(BundledPlatformToolsArchive)')">
    <EmbeddedResource Include="$(BundledPlatformToolsArchive)" LogicalName="FreedomInstaller.PlatformTools.zip" />
  </ItemGroup>

  <!-- Optional legacy offline-updater bootstrap inputs, under the same logical names and metadata as the WPF
       installer. A normal build omits both: installed systems already provide the update service and the
       offline upgrade page connects to the native updater directly (OfflineBootstrapAssets then returns null). -->
  <ItemGroup Condition="'$(BundledOfflineBootstrapScript)' != '' and Exists('$(BundledOfflineBootstrapScript)')">
    <EmbeddedResource Include="$(BundledOfflineBootstrapScript)" LogicalName="FreedomInstaller.OfflineBootstrap.Script.py" WithCulture="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledOfflineUpdaterBundle)' != '' and Exists('$(BundledOfflineUpdaterBundle)')">
    <EmbeddedResource Include="$(BundledOfflineUpdaterBundle)" LogicalName="FreedomInstaller.OfflineBootstrap.Updater.tar.gz" WithCulture="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledOfflineUpdaterVersion)' != ''">
    <AssemblyMetadata Include="BundledOfflineUpdaterVersion" Value="$(BundledOfflineUpdaterVersion)" />
  </ItemGroup>

  <!-- The same third-party notices the WPF installer embeds, byte-for-byte and under the same logical names:
       SharpCompress (MIT), the two boot packers (GPL-3) and inih (BSD-3), all shipped in this app too. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\SharpCompress-LICENSE.txt"
                      LogicalName="FreedomInstaller.Licenses.SharpCompress.txt" />
    <EmbeddedResource Include="..\..\docs\Packer-LICENSE.txt"
                      LogicalName="FreedomInstaller.Licenses.Packer.GPL3.txt" />
    <EmbeddedResource Include="..\..\docs\Inih-LICENSE.txt"
                      LogicalName="FreedomInstaller.Licenses.Inih.BSD3.txt" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\FreedomInstaller.App\Assets\sponsor-zh.png" Link="Assets\sponsor-zh.png" />
    <!-- The About page shares the WPF window's images: every about-* asset upstream adds is picked up here. -->
    <AvaloniaResource Include="..\FreedomInstaller.App\Assets\about-*" Link="Assets\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
