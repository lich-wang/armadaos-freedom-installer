<!--
    macOS 主窗口：版式逐块照搬 FreedomInstaller.App/MainWindow.xaml（顶栏品牌与切换按钮、准备页、
    功能首页、左侧步骤 + 右侧页面、底栏），控件名称与 Windows 版相同，文字一律引用同一份
    Static.* / Dynamic.* 文案。macOS 版开放「安装到内部存储」与「9008 全局备份 / 全局恢复」，其余功能卡片保留但不可用。
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FreedomInstaller.Mac.MainWindow"
        Title="{DynamicResource Static.Title}"
        Width="1100"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="PingFang SC, Helvetica Neue, Arial">


    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= 顶部：品牌 + 支持 / 主题 / 语言 ================= -->
        <Grid Grid.Row="0" Margin="20,12,20,8" ColumnDefinitions="*,Auto,Auto,Auto">
            <Grid Grid.Column="0" VerticalAlignment="Center" ColumnDefinitions="Auto,*">
                <!-- 仓库风帆标记：路径与 Windows 版相同（.github/assets/armada-mark-*.svg，作者 Rax），随主题用 InkBrush 着色。 -->
                <Viewbox Grid.Column="0" Width="48" Height="48" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="ArmadaOS">
                    <Canvas Width="512" Height="512">
                        <Path Fill="{DynamicResource InkBrush}"
                              Data="M316.315 63.5C324.671 102.812 329.069 143.587 329.069 185.389C329.069 256.56 316.323 324.753 292.994 387.813C280.821 386.354 268.43 385.603 255.863 385.603C201.724 385.603 150.84 399.54 106.604 424.022C213.937 333.588 290.014 207.24 316.315 63.5Z" />
                        <Path Fill="{DynamicResource InkBrush}"
                              Data="M356.398 169.27C377.349 214.386 389.045 264.671 389.045 317.689C389.045 349.698 384.781 380.71 376.793 410.191C356.908 401.716 335.953 395.269 314.186 391.106C341.415 323.756 356.411 250.15 356.411 173.041C356.411 171.783 356.406 170.526 356.398 169.27Z" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ArmadaOS Freedom"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="{DynamicResource Static.BrandSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Button x:Name="SupportProjectButton"
                    Grid.Column="1"
                    Theme="{StaticResource SecondaryButton}"
                    Click="OnShowSupport"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    Margin="0,0,8,0">
                <TextBlock Text="{DynamicResource Static.SupportButton}" FontSize="13" VerticalAlignment="Center" />
            </Button>

            <Button x:Name="ThemeToggleButton"
                    Grid.Column="2"
                    Theme="{StaticResource SecondaryButton}"
                    Click="OnToggleTheme"
                    VerticalAlignment="Center"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Border Width="12"
                            Height="12"
                            CornerRadius="6"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ThemeToggleText"
                               FontSize="13"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 语言按钮显示的是「切换目标」，不是当前语言。 -->
            <Button x:Name="LanguageToggleButton"
                    Grid.Column="3"
                    Theme="{StaticResource SecondaryButton}"
                    Click="OnToggleLanguage"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    Margin="8,0,0,0"
                    ToolTip.Tip="{DynamicResource Static.LanguageTooltip}">
                <TextBlock Text="{DynamicResource Static.LanguageToggleLabel}" FontSize="13" VerticalAlignment="Center" />
            </Button>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1" Margin="20,0,20,0" ColumnDefinitions="196,16,*">

            <!-- 左侧导航：只在进入功能向导后显示。 -->
            <Border x:Name="WorkflowSidebar"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12"
                    VerticalAlignment="Top"
                    IsVisible="False">
                <StackPanel>
                    <Button x:Name="BackToFunctionsButton"
                            Content="{DynamicResource Dynamic.BackToFunctions}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnBackToFunctions"
                            Padding="8,4"
                            Margin="0,0,0,10" />

                    <TextBlock Text="{DynamicResource Static.NavSelectedFunction}"
                               Classes="CaptionText"
                               Margin="8,0,0,2" />
                    <TextBlock Text="{DynamicResource Static.Function.Install.Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               TextWrapping="Wrap"
                               Margin="8,0,0,10" />

                    <TextBlock Text="{DynamicResource Static.NavTitle}"
                               Classes="CaptionText"
                               Margin="8,4,0,8" />

                    <StackPanel x:Name="InternalInstallStepNav">
                        <RadioButton x:Name="InternalInstallNavCheck"
                                     GroupName="InternalInstallSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="0"
                                     IsChecked="True"
                                     IsCheckedChanged="OnInternalInstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="01" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Connect}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="InternalInstallNavBackup"
                                     GroupName="InternalInstallSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="1"
                                     IsCheckedChanged="OnInternalInstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="02" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Backup}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="InternalInstallNavCapacity"
                                     GroupName="InternalInstallSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="2"
                                     IsCheckedChanged="OnInternalInstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="03" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Capacity}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="InternalInstallNavConfirm"
                                     GroupName="InternalInstallSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="3"
                                     IsCheckedChanged="OnInternalInstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="04" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Confirm}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= 向导页面 ================= -->
            <ScrollViewer x:Name="WorkflowScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,14,0"
                          Margin="0,0,0,12"
                          IsVisible="False">
                <StackPanel>

                    <!-- ================= 01 连接检测 ================= -->
                    <StackPanel x:Name="InternalInstallCheckPage">
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Check.Title}" Classes="H1Text" />
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Check.Lead}"
                                   Classes="BodyText"
                                   Margin="0,6,0,0" />

                        <TextBlock x:Name="InternalInstallDevicesLabel"
                                   Text="{DynamicResource Static.InternalInstall.Check.DeviceLabel}"
                                   Classes="FieldLabelText"
                                   Margin="0,14,0,6"
                                   IsVisible="False" />
                        <ComboBox x:Name="InternalInstallDevicesCombo"
                                  SelectionChanged="OnInternalInstallDeviceSelected"
                                  IsEnabled="False"
                                  IsVisible="False" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="InternalInstallCheckButton"
                                    Content="{DynamicResource Static.InternalInstall.Check.Button}"
                                    Click="OnCheckInternalInstallDevice"
                                    Theme="{StaticResource PrimaryButton}" />
                        </WrapPanel>

                        <TextBlock x:Name="InternalInstallCheckProgressText"
                                   Classes="BodyInkText"
                                   Margin="0,12,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Check.ProgressInitial}" />
                        <TextBlock x:Name="InternalInstallCheckStatusText"
                                   Classes="BodyText"
                                   Margin="0,4,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Check.StatusInitial}" />

                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Check.FieldsTitle}" Classes="H2Text" />
                                <Grid Margin="0,10,0,0" ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.FieldModel}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InternalInstallModelText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.FieldSerial}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InternalInstallSerialText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.FieldFirmware}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InternalInstallFirmwareText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.FieldBootState}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InternalInstallBootloaderText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Field.Route}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InternalInstallRouteText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Field.Power}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InternalInstallPowerText" Text="—" Classes="FieldValueText" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= 02 系统备份 ================= -->
                    <StackPanel x:Name="InternalInstallBackupPage" IsVisible="False">
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Title}" Classes="H1Text" />
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Warning}"
                                   Classes="BodyText Warn"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.FolderLabel}"
                                   Classes="FieldLabelText"
                                   Margin="0,16,0,6" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="InternalInstallBackupFolderBox"
                                     Grid.Column="0"
                                     Theme="{StaticResource InputTextBox}"
                                     IsReadOnly="True" />
                            <Button x:Name="InternalInstallBackupBrowseButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Static.Browse}"
                                    Click="OnBrowseInternalInstallBackupFolder"
                                    Theme="{StaticResource SecondaryButton}"
                                    IsEnabled="False"
                                    Margin="10,0,0,0" />
                        </Grid>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="InternalInstallBackupButton"
                                    Content="{DynamicResource Static.InternalInstall.Backup.StartButton}"
                                    Click="OnBackupInternalInstall"
                                    Theme="{StaticResource PrimaryButton}"
                                    IsEnabled="False" />
                        </WrapPanel>
                        <ProgressBar x:Name="InternalInstallBackupProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="6"
                                     Margin="0,14,0,0" />
                        <TextBlock x:Name="InternalInstallBackupStatusText"
                                   Classes="BodyInkText"
                                   Margin="0,10,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Backup.StatusInitial}" />
                        <TextBlock x:Name="InternalInstallBackupVerifiedText"
                                   Classes="CaptionText"
                                   Margin="0,4,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Backup.VerifiedInitial}" />
                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.DetailTitle}" Classes="H2Text" />
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.DetailDirectoryLabel}" Classes="FieldLabelText" Margin="0,10,0,4" />
                                <TextBlock x:Name="InternalInstallBackupDirectoryText" Classes="FieldValueText" Text="—" />
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.DetailManifestLabel}" Classes="FieldLabelText" Margin="0,8,0,4" />
                                <TextBlock x:Name="InternalInstallBackupManifestText" Classes="FieldValueText" Text="—" />
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.DetailManifestHashLabel}" Classes="FieldLabelText" Margin="0,8,0,4" />
                                <TextBlock x:Name="InternalInstallBackupManifestHashText" Classes="FieldValueText" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.CoverageTitle}" Classes="H2Text" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Coverage}" Classes="BodyText" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= 03 分配空间 ================= -->
                    <StackPanel x:Name="InternalInstallCapacityPage" IsVisible="False">
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.Title}" Classes="H1Text" />
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.Lead}" Classes="BodyText" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.PackageLabel}" Classes="FieldLabelText" Margin="0,16,0,6" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="InternalInstallPackageBox"
                                     Grid.Column="0"
                                     Theme="{StaticResource InputTextBox}"
                                     IsEnabled="False"
                                     TextChanged="OnInternalInstallPackagePathChanged" />
                            <Button x:Name="InternalInstallPackageBrowseButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Static.Browse}"
                                    Theme="{StaticResource SecondaryButton}"
                                    Click="OnBrowseInternalInstallPackage"
                                    IsEnabled="False"
                                    Margin="10,0,0,0" />
                            <Button x:Name="InternalInstallPackageValidateButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Static.ValidatePackage}"
                                    Theme="{StaticResource SecondaryButton}"
                                    Click="OnValidateInternalInstallPackage"
                                    IsEnabled="False"
                                    Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="InternalInstallPackageStatusText"
                                   Classes="CaptionText"
                                   Margin="0,8,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Capacity.PackageStatusInitial}" />
                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.CardTitle}" Classes="H2Text" />
                                <Grid Margin="0,10,0,0" ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Capacity.TotalLabel}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InternalInstallCapacityTotalText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Capacity.AndroidLabel}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InternalInstallCapacityAndroidText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Capacity.LinuxLabel}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InternalInstallCapacityLinuxText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Capacity.BackupFixedLabel}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Static.InternalInstall.Capacity.BackupFixedValue}" Classes="FieldValueText" />
                                </Grid>
                                <Slider x:Name="InternalInstallCapacitySlider"
                                        Minimum="16"
                                        Maximum="16"
                                        Value="16"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        IsEnabled="False"
                                        ValueChanged="OnInternalInstallCapacityChanged"
                                        Margin="0,14,0,0" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Capacity.Rule}" Classes="CaptionText" Margin="0,10,0,0" />
                                <TextBlock x:Name="InternalInstallCapacityStatusText"
                                           Classes="BodyText"
                                           Margin="0,6,0,0"
                                           Text="{DynamicResource Static.InternalInstall.Capacity.StatusWaiting}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= 04 确认安装 ================= -->
                    <StackPanel x:Name="InternalInstallConfirmPage" IsVisible="False">
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.Title}" Classes="H1Text" />
                        <TextBlock x:Name="InternalInstallConfirmLeadText"
                                   Text="{DynamicResource Static.InternalInstall.Confirm.Lead}"
                                   Classes="BodyText"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.Warning}"
                                   Classes="BodyText Warn"
                                   Margin="0,8,0,0" />

                        <Grid Margin="0,16,0,0" ColumnDefinitions="*,16,*">
                            <Border Grid.Column="0" Classes="CardBorder">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.DeviceCardTitle}" Classes="H2Text" />
                                    <TextBlock Text="{DynamicResource Static.FieldModel}" Classes="FieldLabelText" Margin="0,10,0,0" />
                                    <TextBlock x:Name="InternalInstallConfirmDeviceModelText" Text="—" Classes="FieldValueText" Margin="0,2,0,8" />
                                    <TextBlock Text="{DynamicResource Static.FieldSerial}" Classes="FieldLabelText" />
                                    <TextBlock x:Name="InternalInstallConfirmDeviceSerialText" Text="—" Classes="FieldValueText" Margin="0,2,0,8" />
                                    <TextBlock Text="{DynamicResource Static.FieldFirmware}" Classes="FieldLabelText" />
                                    <TextBlock x:Name="InternalInstallConfirmDeviceFirmwareText" Text="—" Classes="FieldValueText" Margin="0,2,0,8" />
                                    <TextBlock Text="{DynamicResource Static.FieldBootState}" Classes="FieldLabelText" />
                                    <TextBlock x:Name="InternalInstallConfirmDeviceBootloaderText" Text="—" Classes="FieldValueText" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="CardBorder">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PackageCardTitle}" Classes="H2Text" />
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PackageVersionLabel}" Classes="FieldLabelText" Margin="0,10,0,0" />
                                    <TextBlock x:Name="InternalInstallConfirmPackageVersionText" Text="—" Classes="FieldValueText" Margin="0,2,0,8" />
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PackageIdLabel}" Classes="FieldLabelText" />
                                    <TextBlock x:Name="InternalInstallConfirmPackageIdText" Text="—" Classes="FieldValueText" Margin="0,2,0,0" />
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.BootBackupLabel}" Classes="FieldLabelText" Margin="0,14,0,0" />
                                    <TextBlock x:Name="InternalInstallConfirmBootBackupText"
                                               Classes="BodyText"
                                               Margin="0,4,0,0"
                                               Text="{DynamicResource Dynamic.InternalInstall.Confirm.BootPending}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.AllocationTitle}" Classes="H2Text" />
                                <Grid Margin="0,10,0,0" ColumnDefinitions="*,*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.AllocationAndroidLabel}" Classes="FieldLabelText" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InternalInstallConfirmAndroidText" Text="—" Classes="FieldValueText" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.AllocationLinuxLabel}" Classes="FieldLabelText" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InternalInstallConfirmLinuxText" Text="—" Classes="FieldValueText" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.AllocationBackupLabel}" Classes="FieldLabelText" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InternalInstallConfirmRecoveryText" Text="—" Classes="FieldValueText" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,0" ColumnDefinitions="*,16,*">
                            <Border Grid.Column="0" Classes="CardBorder">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.BackupCardTitle}" Classes="H2Text" />
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.BackupPathLabel}" Classes="FieldLabelText" Margin="0,10,0,0" />
                                    <TextBlock x:Name="InternalInstallConfirmBackupPathText" Text="—" Classes="FieldValueText" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="CardBorder">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PowerCardTitle}" Classes="H2Text" />
                                    <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.PowerRecordLabel}" Classes="CaptionText" Margin="0,10,0,0" />
                                    <TextBlock x:Name="InternalInstallConfirmPowerText"
                                               Classes="BodyText"
                                               Margin="0,4,0,0"
                                               Text="{DynamicResource Dynamic.InternalInstall.Power.Unknown}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <CheckBox x:Name="InternalInstallEraseRiskCheck"
                                      Theme="{StaticResource RiskCheckBox}"
                                      IsChecked="False"
                                      IsEnabled="False"
                                      IsCheckedChanged="OnInternalInstallEraseRiskChanged">
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Confirm.EraseRisk}" TextWrapping="Wrap" FontSize="13" />
                            </CheckBox>
                        </Border>
                        <Expander x:Name="InternalInstallVerificationDetails"
                                  Theme="{StaticResource SectionExpander}"
                                  IsExpanded="False"
                                  Header="{DynamicResource Static.InternalInstall.Confirm.VerificationDetailsHeader}">
                            <TextBlock x:Name="InternalInstallSummaryText"
                                       Classes="BodyInkText"
                                       Margin="0,8,0,4"
                                       Text="{DynamicResource Static.InternalInstall.Confirm.SummaryInitial}" />
                        </Expander>
                        <TextBlock x:Name="InternalInstallConfirmStatusText"
                                   Classes="BodyInkText"
                                   Margin="0,14,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Confirm.StatusWaiting}" />
                        <ProgressBar x:Name="InternalInstallConfirmProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="6"
                                     IsVisible="False"
                                     Margin="0,10,0,0" />
                        <TextBlock x:Name="InternalInstallAcceptanceStatusText"
                                   Classes="CaptionText"
                                   Margin="0,6,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Confirm.AcceptanceInitial}" />
                    </StackPanel>

                    <!-- 只要还有真实 9008 会话就显示：复位退出 9008。 -->
                    <Border x:Name="InternalInstallExitMaintenancePanel"
                            Classes="CardBorder"
                            Margin="0,16,0,0"
                            IsVisible="False">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Exit.Title}" Classes="H2Text" />
                            <Button x:Name="InternalInstallExitMaintenanceButton"
                                    Content="{DynamicResource Dynamic.InternalInstall.Exit.Button}"
                                    Click="OnExitInternalInstallMaintenance"
                                    Theme="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                            <TextBlock x:Name="InternalInstallExitMaintenanceStatusText"
                                       Classes="BodyText"
                                       Margin="0,8,0,0"
                                       Text="{DynamicResource Dynamic.InternalInstall.Exit.StatusIdle}" />
                        </StackPanel>
                    </Border>

                    <!-- 四个页面共用的日志 -->
                    <Border Classes="CardBorder" Margin="0,16,0,0">
                        <Expander x:Name="InternalInstallLogExpander" Theme="{StaticResource SectionExpander}" Margin="0" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Log.Title}" Classes="H2Text" />
                            </Expander.Header>
                            <ScrollViewer x:Name="InternalInstallLogScrollViewer"
                                          Height="160"
                                          Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="InternalInstallLogEmptyText"
                                               Text="{DynamicResource Dynamic.InternalInstall.Log.Empty}"
                                               Classes="CaptionText" />
                                    <StackPanel x:Name="InternalInstallLogList" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 运行环境准备 ================= -->
            <ScrollViewer x:Name="EnvironmentPage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,14,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Static.Environment.Title}" Classes="H1Text" />
                    <TextBlock Text="{DynamicResource Static.Environment.Lead}" Classes="BodyText" Margin="0,6,0,0" />
                    <Border Classes="CardBorder" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12" ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Environment.System}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EnvironmentSystemStatusText" Text="{DynamicResource Dynamic.Environment.Checking}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,12" ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Environment.Runtime}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Environment.RuntimeIncluded}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,12" ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Environment.Tools}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EnvironmentToolsStatusText" Text="{DynamicResource Dynamic.Environment.Checking}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,12" ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Environment.Driver}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EnvironmentDriverStatusText" Text="{DynamicResource Dynamic.Environment.Checking}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="EnvironmentStatusText"
                                               Text="{DynamicResource Dynamic.Environment.Checking}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Environment.Guide}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="EnvironmentCheckButton"
                                        Content="{DynamicResource Static.Environment.Check}"
                                        Click="OnEnvironmentCheck"
                                        Theme="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                                <Button x:Name="EnvironmentContinueButton"
                                        Content="{DynamicResource Static.Environment.Continue}"
                                        Click="OnEnvironmentContinue"
                                        Theme="{StaticResource SecondaryButton}"
                                        IsEnabled="False"
                                        Margin="0,0,8,8" />
                                <Button x:Name="EnvironmentGlobalRestoreButton"
                                        Content="{DynamicResource Static.Global.RestoreTitle}"
                                        Click="OnOpenGlobalRestoreFromEnvironment"
                                        Theme="{StaticResource SecondaryButton}"
                                        IsVisible="False"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 功能首页 ================= -->
            <ScrollViewer x:Name="HomePage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="False"
                          Padding="0,0,14,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="HomeEnvironmentButton"
                                DockPanel.Dock="Right"
                                Theme="{StaticResource SecondaryButton}"
                                Content="{DynamicResource Static.Environment.HomeLink}"
                                Click="OnShowEnvironment"
                                FontSize="11"
                                Padding="8,4"
                                VerticalAlignment="Top"
                                Margin="8,0,0,0" />
                        <TextBlock Text="{DynamicResource Static.HomeTitle}" Classes="H1Text" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Static.HomeLead}" Classes="BodyText" Margin="0,6,0,0" />
                    <UniformGrid x:Name="HomeCards" Columns="2" Margin="0,12,0,0">
                        <Button Tag="install" Click="OnSelectOperation" Theme="{StaticResource FunctionCard}" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Classes="FunctionCardIcon">
                                    <Path Data="M 7 2 H 17 V 22 H 7 Z M 10 19 H 14" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Function.Install.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Function.Install.Desc}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="offline-upgrade" Click="OnSelectOperation" Theme="{StaticResource FunctionCard}" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Classes="FunctionCardIcon">
                                    <Path Data="M 12 3 V 15 M 7 10 L 12 15 L 17 10 M 5 20 H 19" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Function.OfflineUpdate.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Function.OfflineUpdate.Desc}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="prepare" Click="OnSelectOperation" Theme="{StaticResource FunctionCard}" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Classes="FunctionCardIcon">
                                    <Path Data="M 12 3 V 15 M 7 10 L 12 15 L 17 10 M 4 20 H 20" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Function.Prepare.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Function.Prepare.Desc}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="repair" Click="OnSelectOperation" Theme="{StaticResource FunctionCard}" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Classes="FunctionCardIcon">
                                    <Path Data="M 4 12 C 4 7.6 7.6 4 12 4 M 4 8 V 12 H 8 M 20 12 C 20 16.4 16.4 20 12 20 M 20 16 V 12 H 16" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Function.Repair.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Function.Repair.Desc}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="uninstall" Click="OnSelectOperation" Theme="{StaticResource FunctionCard}" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Classes="FunctionCardIcon">
                                    <Path Data="M 4 12 H 15 M 11 8 L 15 12 L 11 16 M 19 5 V 19" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Function.Uninstall.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Function.Uninstall.Desc}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="global-backup" Click="OnSelectOperation" Theme="{StaticResource FunctionCard}" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Classes="FunctionCardIcon">
                                    <Path Data="M 12 3 V 14 M 8 10 L 12 14 L 16 10 M 4 19 H 20" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Function.GlobalBackup.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Function.GlobalBackup.Desc}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="global-restore" Click="OnSelectOperation" Theme="{StaticResource FunctionCard}" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Classes="FunctionCardIcon">
                                    <Path Data="M 12 15 V 4 M 8 8 L 12 4 L 16 8 M 4 19 H 20" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Static.Function.GlobalRestore.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Static.Function.GlobalRestore.Desc}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 9008 全局备份 / 全局恢复（与 WPF 窗口的全局救援页一致） ================= -->
            <ScrollViewer x:Name="GlobalRecoveryPage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="False"
                          Padding="0,0,14,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="GlobalBackupTitleText" Text="{DynamicResource Static.Global.BackupTitle}" Classes="H1Text" />
                    <TextBlock x:Name="GlobalRestoreTitleText" Text="{DynamicResource Static.Global.RestoreTitle}" Classes="H1Text" IsVisible="False" />
                    <TextBlock x:Name="GlobalBackupLeadText" Text="{DynamicResource Static.Global.BackupLead}" Classes="BodyText" Margin="0,6,0,0" />
                    <TextBlock x:Name="GlobalRestoreLeadText" Text="{DynamicResource Static.Global.ManualRestoreLead}" Classes="BodyText" Margin="0,6,0,0" IsVisible="False" />

                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="GlobalBackHomeButton"
                                Content="{DynamicResource Static.Global.BackHome}"
                                Click="OnGlobalBackHome"
                                Theme="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8" />
                    </WrapPanel>

                    <!-- 仅恢复视图显示的 9008 手动进入指南；默认折叠但展开状态为 True，不自动访问设备。 -->
                    <Expander x:Name="GlobalManualEdlGuide"
                              IsExpanded="True"
                              IsVisible="False"
                              Margin="0,12,0,0"
                              Header="{DynamicResource Static.Global.ManualEdlGuideTitle}">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{DynamicResource Static.Global.ManualEdlForceShutdown}"
                                       Classes="BodyText"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,0" />
                            <TextBlock Text="{DynamicResource Static.Global.ManualEdlStep1}"
                                       Classes="BodyText"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource Static.Global.ManualEdlTb323fu}"
                                       Classes="BodyText"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <Viewbox Stretch="Uniform" MaxWidth="360" MaxHeight="154"
                                     HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Canvas Width="360" Height="154">
                                    <!-- 顶部标签区：按 TB323FU 正面横向渲染，音量加键位于上长边靠左。 -->
                                    <TextBlock Canvas.Left="10" Canvas.Top="3" Width="210"
                                               Text="{DynamicResource Static.Global.ManualEdlVolumeUp}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Left" />
                                    <!-- 引线：从文字下方起始，绕至音量加键上缘，不穿越文字。 -->
                                    <Path Data="M 36,17 L 36,26 L 39,30"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.5" />
                                    <!-- 平板：屏幕面向用户横向放置。 -->
                                    <Rectangle Canvas.Left="12" Canvas.Top="34" Width="144" Height="90"
                                               RadiusX="8" RadiusY="8"
                                               Fill="{DynamicResource SurfaceBrush}"
                                               Stroke="{DynamicResource StrokeBrush}"
                                               StrokeThickness="2" />
                                    <Rectangle Canvas.Left="18" Canvas.Top="40" Width="132" Height="78"
                                               RadiusX="4" RadiusY="4"
                                               Fill="#0F1115" />
                                    <!-- 上长边按键：音量加键高亮部分偏左端，中间为中性其余部分，电源键靠右。 -->
                                    <Rectangle Canvas.Left="32" Canvas.Top="30" Width="13" Height="5"
                                               RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource AccentBrush}" />
                                    <Rectangle Canvas.Left="45" Canvas.Top="30" Width="8" Height="5"
                                               RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SurfaceBrush}"
                                               Stroke="{DynamicResource StrokeBrush}"
                                               StrokeThickness="1" />
                                    <Rectangle Canvas.Left="59" Canvas.Top="30" Width="11" Height="5"
                                               RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SurfaceBrush}"
                                               Stroke="{DynamicResource StrokeBrush}"
                                               StrokeThickness="1" />
                                    <!-- 右侧短边次要接口：开口状态，保持低调。 -->
                                    <Rectangle Canvas.Left="156" Canvas.Top="76" Width="4" Height="10"
                                               RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource MutedBrush}"
                                               Opacity="0.5" />
                                    <!-- 下长边中央 USB-C 接口与插头。 -->
                                    <Rectangle Canvas.Left="76" Canvas.Top="121" Width="16" Height="6"
                                               RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SurfaceBrush}"
                                               Stroke="{DynamicResource StrokeBrush}"
                                               StrokeThickness="1" />
                                    <Rectangle Canvas.Left="79" Canvas.Top="126" Width="10" Height="9"
                                               RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource SurfaceBrush}"
                                               Stroke="{DynamicResource StrokeBrush}"
                                               StrokeThickness="1" />
                                    <!-- 下长边中央 USB-C 接口标注：单行，避开 y145 走线。 -->
                                    <TextBlock Canvas.Left="100" Canvas.Top="124" Width="110"
                                               Text="{DynamicResource Static.Global.ManualEdlLongEdgePort}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="10"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Left" />
                                    <!-- 电脑：底座与上盖。 -->
                                    <Rectangle Canvas.Left="244" Canvas.Top="36" Width="100" Height="51"
                                               RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource SurfaceBrush}"
                                               Stroke="{DynamicResource StrokeBrush}"
                                               StrokeThickness="2" />
                                    <Rectangle Canvas.Left="234" Canvas.Top="87" Width="120" Height="10"
                                               RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SurfaceBrush}"
                                               Stroke="{DynamicResource StrokeBrush}"
                                               StrokeThickness="2" />
                                    <!-- 电脑侧插头：底座外左侧，接触底座左缘 x234。 -->
                                    <Rectangle Canvas.Left="222" Canvas.Top="87" Width="12" Height="10"
                                               RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource SurfaceBrush}"
                                               Stroke="{DynamicResource StrokeBrush}"
                                               StrokeThickness="1" />
                                    <!-- 数据线：从平板下长边插头向下，右折至 x212 上行接电脑侧插头。 -->
                                    <Path Data="M 84,135 L 84,145 L 212,145 L 212,92 L 222,92"
                                          Stroke="{DynamicResource MutedBrush}"
                                          StrokeThickness="3"
                                          StrokeJoin="Round" />
                                    <!-- 黑屏说明置于深色屏幕内部，固定浅色避免与 #0F1115 重影。 -->
                                    <TextBlock Canvas.Left="18" Canvas.Top="68" Width="132"
                                               Text="{DynamicResource Static.Global.ManualEdlScreenDark}"
                                               Foreground="#DFE2E7"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                    <TextBlock Canvas.Left="244" Canvas.Top="106" Width="100"
                                               Text="{DynamicResource Static.Global.ManualEdlPc}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource Static.Global.ManualEdlStep2}"
                                       Classes="BodyText"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource Static.Global.ManualEdlStep3}"
                                       Classes="BodyText"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>

                    <!-- 连接：型号由连接时自动识别；进入本页不会自动访问设备。 -->
                    <Border Classes="CardBorder" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="GlobalAndroidConnectionGuide" Text="{DynamicResource Static.Global.ConnectionGuideLead}" Classes="BodyText" />
                            <TextBlock x:Name="GlobalAutoDetectText" Text="{DynamicResource Static.Global.AutoDetect}" Classes="CaptionText" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,10,0,10">
                                <Button x:Name="GlobalConnectButton"
                                        Content="{DynamicResource Static.Global.Connect}"
                                        Click="OnGlobalConnect"
                                        Theme="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="GlobalConnectionText" Text="{DynamicResource Dynamic.Global.Idle}" Classes="BodyInkText" FontWeight="SemiBold" />
                            <TextBlock x:Name="GlobalPowerText" Text="{DynamicResource Static.Global.PowerInitial}" Classes="CaptionText" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 备份保存位置：只在备份视图出现；恢复的工作记录目录由程序自动使用。 -->
                    <Border x:Name="GlobalOutputSection" Classes="CardBorder" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.Global.BackupDirectoryLabel}" Classes="CaptionText" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBox x:Name="GlobalBackupDirectoryBox" Grid.Column="0" Theme="{StaticResource InputTextBox}" IsReadOnly="True" />
                                <Button x:Name="GlobalBrowseBackupButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Static.Global.Browse}"
                                        Click="OnGlobalBrowseBackup"
                                        Theme="{StaticResource SecondaryButton}"
                                        Margin="10,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 视图 1：全局备份 -->
                    <Border x:Name="GlobalBackupCard" Classes="CardBorder" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.Global.BackupBody}" Classes="BodyText" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="GlobalBackupButton"
                                        Content="{DynamicResource Static.Global.BackupButton}"
                                        Click="OnGlobalBackupAction"
                                        Theme="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="GlobalBackupSummaryText" Text="{DynamicResource Dynamic.Global.NoBackup}" Classes="CaptionText" />
                        </StackPanel>
                    </Border>

                    <!-- 视图 2：全局恢复。必须绑定这台平板自己的完整备份，默认不显示。 -->
                    <Border x:Name="GlobalRestoreCard" Classes="CardBorder" Margin="0,12,0,0" IsVisible="False">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.Global.RestoreBody}" Classes="BodyText" />
                            <TextBlock Text="{DynamicResource Static.Global.RestoreDirectoryLabel}" Classes="CaptionText" Margin="0,10,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBox x:Name="GlobalRestoreDirectoryBox" Grid.Column="0" Theme="{StaticResource InputTextBox}" IsReadOnly="True" />
                                <Button x:Name="GlobalBrowseRestoreButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Static.Global.Browse}"
                                        Click="OnGlobalBrowseRestore"
                                        Theme="{StaticResource SecondaryButton}"
                                        Margin="10,0,0,0" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="GlobalPrepareRestoreButton"
                                        Content="{DynamicResource Static.Global.PrepareRestore}"
                                        Click="OnGlobalPrepareRestoreAction"
                                        Theme="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="GlobalRestoreSummaryText" Text="{DynamicResource Dynamic.Global.NoRestorePlan}" Classes="CaptionText" Margin="0,0,0,8" />
                            <CheckBox x:Name="GlobalRestoreConfirmCheck"
                                      Theme="{StaticResource RiskCheckBox}"
                                      IsChecked="False"
                                      IsCheckedChanged="OnGlobalRestoreConsentChanged"
                                      Margin="0,10,0,10">
                                <TextBlock Text="{DynamicResource Static.Global.RestoreConsent}" TextWrapping="Wrap" FontSize="13" />
                            </CheckBox>
                            <WrapPanel>
                                <Button x:Name="GlobalRestoreButton"
                                        Content="{DynamicResource Static.Global.RestoreButton}"
                                        Click="OnGlobalRestoreAction"
                                        Theme="{StaticResource PrimaryButton}"
                                        IsEnabled="False"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 公共进度：不提供虚假的完成或成功状态。 -->
                    <Border Classes="CardBorder" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="GlobalProgressStatusText" Text="{DynamicResource Dynamic.Global.Idle}" Classes="BodyInkText" FontWeight="SemiBold" />
                            <ProgressBar x:Name="GlobalProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="GlobalRestartButton"
                                        Content="{DynamicResource Static.Global.Restart}"
                                        Click="OnGlobalRestart"
                                        Theme="{StaticResource SecondaryButton}"
                                        IsEnabled="False"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="CardBorder" Margin="0,12,0,0">
                        <Expander Theme="{StaticResource SectionExpander}" Margin="0" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="{DynamicResource Static.Global.LogTitle}" Classes="H2Text" />
                            </Expander.Header>
                            <ScrollViewer x:Name="GlobalLogScrollViewer"
                                          Height="180"
                                          Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="GlobalLogEmptyText" Text="{DynamicResource Dynamic.Global.LogEmpty}" Classes="CaptionText" />
                                    <StackPanel x:Name="GlobalLogList" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 离线升级（与 WPF 窗口的 OfflineUpgradeView 一致；控件名加 Offline 前缀） ================= -->
            <ScrollViewer x:Name="OfflineUpgradePage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="False"
                          Padding="0,0,14,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <Button x:Name="OfflineBackButton" Theme="{StaticResource GhostButton}" Content="{DynamicResource Static.OfflineUpdate.Back}" Click="OnOfflineUpgradeBackAsync" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource Static.OfflineUpdate.Title}" Classes="H1Text" />
                    <TextBlock Text="{DynamicResource Static.OfflineUpdate.Desc}" Classes="BodyInkText" TextWrapping="Wrap" Margin="0,4,0,14" />

                    <Border Classes="CardBorder" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.SectionConnection}" Classes="H2Text" />
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.ConnectionHelper}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <TextBlock x:Name="OfflineTransportLabel" Text="{DynamicResource Static.OfflineUpdate.Transport}" Classes="FieldLabelText" Margin="0,0,0,4" />
                            <ComboBox x:Name="OfflineTransportCombo" SelectedIndex="0" SelectionChanged="OnOfflineConnectionSelectionChanged" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                <ComboBoxItem x:Name="OfflineTransportUsbItem" Content="{DynamicResource Static.OfflineUpdate.TransportUsb}" />
                                <ComboBoxItem x:Name="OfflineTransportWifiItem" Content="{DynamicResource Static.OfflineUpdate.TransportWifi}" />
                            </ComboBox>

                            <TextBlock x:Name="OfflineUsbAddressHint" Text="{DynamicResource Static.OfflineUpdate.UsbAddressHint}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <StackPanel x:Name="OfflineWifiAddressPanel" IsVisible="False" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="110,*,110,*">
                                    <TextBlock x:Name="OfflineWifiAddressLabel" Text="{DynamicResource Static.OfflineUpdate.WifiAddress}" Classes="FieldLabelText" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="OfflineHostBox" Grid.Column="1" Theme="{StaticResource InputTextBox}" Margin="0,0,14,0" />
                                    <TextBlock x:Name="OfflinePortLabel" Grid.Column="2" Text="{DynamicResource Static.OfflineUpdate.Port}" Classes="FieldLabelText" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="OfflinePortBox" Grid.Column="3" Theme="{StaticResource InputTextBox}" Text="22" />
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="OfflineCredentialLabel" Text="{DynamicResource Static.OfflineUpdate.Credential}" Classes="FieldLabelText" Margin="0,0,0,4" />
                            <ComboBox x:Name="OfflineCredentialCombo" SelectedIndex="0" SelectionChanged="OnOfflineConnectionSelectionChanged" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                <ComboBoxItem x:Name="OfflineCredentialDefaultItem" Content="{DynamicResource Static.OfflineUpdate.CredentialDefault}" />
                                <ComboBoxItem x:Name="OfflineCredentialCustomItem" Content="{DynamicResource Static.OfflineUpdate.CredentialCustom}" />
                                <ComboBoxItem x:Name="OfflineCredentialKeyItem" Content="{DynamicResource Static.OfflineUpdate.CredentialKey}" />
                            </ComboBox>

                            <TextBlock x:Name="OfflineDefaultAccountText" Text="{DynamicResource Static.OfflineUpdate.DefaultAccountSummary}" Classes="FieldValueText" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <StackPanel x:Name="OfflineManualUserNamePanel" IsVisible="False">
                                <TextBlock x:Name="OfflineUserLabel" Text="{DynamicResource Static.OfflineUpdate.User}" Classes="FieldLabelText" Margin="0,0,0,4" />
                                <TextBox x:Name="OfflineUserBox" Theme="{StaticResource InputTextBox}" />
                            </StackPanel>

                            <StackPanel x:Name="OfflineCustomPasswordPanel" IsVisible="False">
                                <TextBlock x:Name="OfflinePasswordLabel" Text="{DynamicResource Static.OfflineUpdate.Password}" Classes="FieldLabelText" Margin="0,10,0,4" />
                                <TextBox x:Name="OfflinePasswordBox" Theme="{StaticResource InputTextBox}" PasswordChar="●" MaxLength="512" />
                                <TextBlock Text="{DynamicResource Static.OfflineUpdate.PasswordPrivacy}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="OfflineKeyFieldsPanel" IsVisible="False">
                                <TextBlock x:Name="OfflineUsbKeyEnrollmentHint" Text="{DynamicResource Static.OfflineUpdate.UsbKeyEnrollmentHint}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,10,0,10" />
                                <TextBlock x:Name="OfflineWifiKeyEnrollmentHint" Text="{DynamicResource Static.OfflineUpdate.WifiKeyEnrollmentHint}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,10,0,10" IsVisible="False" />
                                <TextBlock x:Name="OfflineKeyPathLabel" Text="{DynamicResource Static.OfflineUpdate.KeyPath}" Classes="FieldLabelText" Margin="0,0,0,4" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="OfflineKeyPathBox" Theme="{StaticResource InputTextBox}" Margin="0,0,8,0" />
                                    <Button x:Name="OfflineBrowseKeyButton" Grid.Column="1" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.BrowseKey}" Click="OnBrowseOfflineKey" />
                                </Grid>
                                <TextBlock Text="{DynamicResource Static.OfflineUpdate.KeyPrivacy}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <TextBlock x:Name="OfflineKnownHostsLabel" Text="{DynamicResource Static.OfflineUpdate.KnownHosts}" Classes="FieldLabelText" Margin="0,0,0,4" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="OfflineKnownHostsBox" Theme="{StaticResource InputTextBox}" Margin="0,0,8,0" />
                                    <Button x:Name="OfflineBrowseHostsButton" Grid.Column="1" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.BrowseHosts}" Click="OnBrowseOfflineKnownHosts" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="OfflineConnectButton" Theme="{StaticResource PrimaryButton}" Content="{DynamicResource Static.OfflineUpdate.ConnectTablet}" Click="OnConnectOfflineTabletAsync" Margin="0,0,8,0" />
                                <Button x:Name="OfflineDisconnectButton" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.Disconnect}" Click="OnDisconnectOfflineSshAsync" IsEnabled="False" />
                            </StackPanel>

                            <StackPanel x:Name="OfflinePairingPanel" IsVisible="False" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Static.OfflineUpdate.PairingHeading}" Classes="H2Text" Margin="0,0,0,4" />
                                <TextBlock Text="{DynamicResource Static.OfflineUpdate.PairingInstructions}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock x:Name="OfflinePairingHostText" Classes="CaptionText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource Static.OfflineUpdate.PairingCommand}" Classes="FieldLabelText" Margin="0,0,0,4" />
                                <TextBox x:Name="OfflinePairingCommandBox" Theme="{StaticResource InputTextBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="55" MaxHeight="95" />
                                <Button x:Name="OfflineCopyPairingCommandButton" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.CopyPairingCommand}" Click="OnCopyOfflinePairingCommand" HorizontalAlignment="Left" Margin="0,8,0,10" />
                                <TextBlock Text="{DynamicResource Static.OfflineUpdate.PairingReceipt}" Classes="FieldLabelText" Margin="0,0,0,4" />
                                <TextBox x:Name="OfflinePairingReceiptBox" Theme="{StaticResource InputTextBox}" MaxLength="4096" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65" MaxHeight="105" TextChanged="OnOfflinePairingReceiptChanged" Margin="0,0,0,8" />
                                <Button x:Name="OfflineConfirmPairingButton" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.ConfirmPairing}" Click="OnConfirmOfflinePairingAsync" HorizontalAlignment="Left" IsEnabled="False" />
                            </StackPanel>

                            <TextBlock x:Name="OfflineDeviceText" Text="{DynamicResource Static.OfflineUpdate.DevicePending}" Classes="FieldValueText" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Classes="CardBorder" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.SectionPackage}" Classes="H2Text" />
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.PackageHelp}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.PackagePath}" Classes="FieldLabelText" Margin="0,0,0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="OfflinePackagePathBox" Theme="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,8,0" />
                                <Button x:Name="OfflineBrowsePackageButton" Grid.Column="1" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.BrowsePackage}" Click="OnBrowseOfflinePackage" />
                            </Grid>
                            <Button x:Name="OfflineValidatePackageButton" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.ValidatePackage}" Click="OnValidateOfflinePackageAsync" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock x:Name="OfflinePackageText" Text="{DynamicResource Static.OfflineUpdate.PackagePending}" Classes="FieldValueText" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.Session}" Classes="FieldLabelText" Margin="0,10,0,4" />
                            <ComboBox x:Name="OfflineSessionCombo" SelectionChanged="OnOfflineSessionSelectionChanged" HorizontalAlignment="Stretch" IsEnabled="False" />
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.SessionHelper}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="OfflineRefreshButton" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.Refresh}" Click="OnRefreshOfflineStatusAsync" Margin="0,0,8,0" />
                                <Button x:Name="OfflinePrepareButton" Theme="{StaticResource PrimaryButton}" Content="{DynamicResource Static.OfflineUpdate.Prepare}" Click="OnPrepareOfflineUpgradeAsync" IsEnabled="False" />
                            </StackPanel>
                            <!-- 与 WPF 一致：只为已核实的失败准备显示，单独确认后开新会话，从不重试失败的记录。 -->
                            <Button x:Name="OfflineStartReplacementSessionButton" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.StartReplacementSession}" Click="OnStartReplacementOfflineSessionAsync" IsEnabled="False" IsVisible="False" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Classes="CardBorder" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.SectionConfirm}" Classes="H2Text" />
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.PrepareHelp}" Classes="CaptionText" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <CheckBox x:Name="OfflineConfirmCheck" Theme="{StaticResource RiskCheckBox}" IsCheckedChanged="OnOfflineConfirmChanged" IsEnabled="False">
                                <TextBlock Text="{DynamicResource Static.OfflineUpdate.Confirm}" TextWrapping="Wrap" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="OfflineExecuteButton" Theme="{StaticResource PrimaryButton}" Content="{DynamicResource Static.OfflineUpdate.Execute}" Click="OnExecuteOfflineUpgradeAsync" IsEnabled="False" Margin="0,0,8,0" />
                                <Button x:Name="OfflineStopWaitingButton" Theme="{StaticResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.StopWaiting}" Click="OnStopWaitingOfflineUpgrade" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="CardBorder" Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel>
                            <TextBlock x:Name="OfflineStateText" Text="{DynamicResource Static.OfflineUpdate.StatePending}" Classes="BodyInkText" TextWrapping="Wrap" />
                            <Button x:Name="OfflineRestartToVerifyButton" Theme="{StaticResource PrimaryButton}" Content="{DynamicResource Static.OfflineUpdate.RestartToVerify}" Click="OnRestartToVerifyOfflineUpgradeAsync" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            <ProgressBar x:Name="OfflineTransferProgress" Minimum="0" Maximum="100" Value="0" Height="8" Margin="0,8,0,4" />
                            <TextBlock x:Name="OfflineProgressText" Classes="CaptionText" Text="0%" />
                            <TextBlock Text="{DynamicResource Static.OfflineUpdate.RecoveryPath}" Classes="FieldLabelText" Margin="0,8,0,2" />
                            <TextBlock x:Name="OfflineRecoveryPathText" Text="{DynamicResource Static.OfflineUpdate.RecoveryPending}" Classes="FieldValueText" TextWrapping="Wrap" />
                            <Expander x:Name="OfflineDetailsExpander" Theme="{StaticResource SectionExpander}" IsExpanded="False" Margin="0,8,0,0">
                                <Expander.Header>
                                    <TextBlock Text="{DynamicResource Static.OfflineUpdate.Details}" Classes="H2Text" />
                                </Expander.Header>
                                <TextBlock x:Name="OfflineDetailsText" Text="{DynamicResource Static.OfflineUpdate.DetailsPending}" Classes="BodyText" TextWrapping="Wrap" />
                            </Expander>
                            <Expander x:Name="OfflineLogExpander" Theme="{StaticResource SectionExpander}" IsExpanded="False" Margin="0,6,0,0">
                                <Expander.Header>
                                    <TextBlock Text="{DynamicResource Static.OfflineUpdate.Log}" Classes="H2Text" />
                                </Expander.Header>
                                <TextBox x:Name="OfflineLogText" Theme="{StaticResource InputTextBox}" IsReadOnly="True" MaxHeight="200" TextWrapping="Wrap" AcceptsReturn="True" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Android 更新前准备 / 更新后修复（与 WPF 窗口的引导维护四步一致；控件名加 BootMaintenance 前缀） ================= -->
            <ScrollViewer x:Name="BootMaintenancePage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="False"
                          Padding="0,0,14,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <Button x:Name="BootMaintenanceBackButton"
                            Content="{DynamicResource Dynamic.BackToFunctions}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnBootMaintenanceBackHome"
                            HorizontalAlignment="Left"
                            Padding="8,4"
                            Margin="0,0,0,10" />
                    <TextBlock x:Name="BootMaintenanceModeTitle" Classes="H1Text" />
                    <TextBlock x:Name="BootMaintenanceModeHint" Classes="BodyText" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <!-- 四步导航：与 WPF 共享四步侧栏的维护标签一致。 -->
                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <RadioButton x:Name="BootMaintenanceNavCheck"
                                     GroupName="BootMaintenanceSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="0"
                                     IsChecked="True"
                                     IsCheckedChanged="OnBootMaintenanceNavChecked"
                                     Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="01" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Connect}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BootMaintenanceNavBackup"
                                     GroupName="BootMaintenanceSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="1"
                                     IsCheckedChanged="OnBootMaintenanceNavChecked"
                                     Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="02" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Backup}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BootMaintenanceNavSources"
                                     GroupName="BootMaintenanceSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="2"
                                     IsCheckedChanged="OnBootMaintenanceNavChecked"
                                     Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="03" FontSize="11" />
                                <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.Nav.Sources}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BootMaintenanceNavConfirm"
                                     GroupName="BootMaintenanceSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="3"
                                     IsCheckedChanged="OnBootMaintenanceNavChecked">
                            <StackPanel>
                                <TextBlock Text="04" FontSize="11" />
                                <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.Nav.Confirm}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- 01 连接检测：默认只读安卓身份；9008 路线用历史备份核对；高级完整检查进入 Fastboot。 -->
                    <StackPanel x:Name="BootMaintenanceCheckPage" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Check.Title}" Classes="H1Text" />
                        <TextBlock Text="{DynamicResource Dynamic.Shared.DeviceCheckLead}" Classes="BodyText" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Static.Connection.Gen4UsbPortHint}"
                                   Classes="BodyInkText"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <TextBlock x:Name="BootMaintenanceDevicesLabel"
                                   Text="{DynamicResource Static.InternalInstall.Check.DeviceLabel}"
                                   Classes="FieldLabelText"
                                   Margin="0,14,0,6"
                                   IsVisible="False" />
                        <ComboBox x:Name="BootMaintenanceDevicesCombo"
                                  SelectionChanged="OnBootMaintenanceDeviceSelected"
                                  IsEnabled="False"
                                  IsVisible="False" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="BootMaintenanceCheckButton"
                                    Click="OnCheckBootMaintenanceDevice"
                                    Theme="{StaticResource PrimaryButton}">
                                <TextBlock x:Name="BootMaintenanceCheckButtonText" Text="{DynamicResource Dynamic.Shared.CheckTablet}" />
                            </Button>
                        </WrapPanel>

                        <StackPanel x:Name="BootMaintenanceEntryPanel" Margin="0,14,0,0">
                            <CheckBox x:Name="BootMaintenanceAlreadyEdlCheck"
                                      Content="{DynamicResource Dynamic.BootMaintenance.AlreadyEdl}"
                                      IsCheckedChanged="OnBootMaintenanceEdlRouteChanged" />
                            <TextBlock x:Name="BootMaintenanceEdlHintText"
                                       Text="{DynamicResource Dynamic.BootMaintenance.EdlHint}"
                                       Classes="CaptionText"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.OriginalSource}"
                                       Classes="FieldLabelText"
                                       Margin="0,12,0,6" />
                            <Grid x:Name="BootMaintenanceEntryOriginalRow" ColumnDefinitions="*,Auto">
                                <TextBox x:Name="BootMaintenanceEntryOriginalBox"
                                         Grid.Column="0"
                                         Theme="{StaticResource InputTextBox}"
                                         IsReadOnly="True" />
                                <Button x:Name="BootMaintenanceEntryOriginalBrowseButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Static.Browse}"
                                        Click="OnBrowseBootMaintenanceOriginal"
                                        Theme="{StaticResource SecondaryButton}"
                                        Margin="10,0,0,0" />
                            </Grid>

                            <Expander Theme="{StaticResource SectionExpander}" IsExpanded="False" Margin="0,12,0,0">
                                <Expander.Header>
                                    <TextBlock Text="{DynamicResource Dynamic.Shared.AdvancedCheckHeader}"
                                               Classes="BodyInkText"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Dynamic.Shared.AdvancedCheckWarning}"
                                               Classes="CaptionText"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,6" />
                                    <Button x:Name="BootMaintenanceFastbootCheckButton"
                                            Content="{DynamicResource Dynamic.Shared.AdvancedCheckButton}"
                                            Click="OnCheckBootMaintenanceDeviceAdvanced"
                                            Theme="{StaticResource SecondaryButton}"
                                            IsEnabled="False"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <TextBlock x:Name="BootMaintenanceCheckProgressText"
                                   Classes="BodyInkText"
                                   Margin="0,12,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Check.ProgressInitial}" />
                        <TextBlock x:Name="BootMaintenanceCheckStatusText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Check.StatusInitial}" />

                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Check.FieldsTitle}" Classes="H2Text" />
                                <Grid Margin="0,10,0,0" ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.FieldModel}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BootMaintenanceModelText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.FieldSerial}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BootMaintenanceSerialText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.FieldFirmware}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BootMaintenanceFirmwareText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.FieldBootState}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BootMaintenanceBootloaderText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Field.Route}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BootMaintenanceRouteText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Field.Power}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="BootMaintenancePowerText" Text="—" Classes="FieldValueText" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 02 系统备份：只允许全新备份（维护模式不复用已有备份）。 -->
                    <StackPanel x:Name="BootMaintenanceBackupPage" IsVisible="False" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Title}" Classes="H1Text" />
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Warning}"
                                   Classes="BodyText Warn"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.FolderLabel}"
                                   Classes="FieldLabelText"
                                   Margin="0,16,0,6" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="BootMaintenanceBackupFolderBox"
                                     Grid.Column="0"
                                     Theme="{StaticResource InputTextBox}"
                                     IsReadOnly="True" />
                            <Button x:Name="BootMaintenanceBackupBrowseButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Static.Browse}"
                                    Click="OnBrowseBootMaintenanceBackupFolder"
                                    Theme="{StaticResource SecondaryButton}"
                                    IsEnabled="False"
                                    Margin="10,0,0,0" />
                        </Grid>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="BootMaintenanceBackupButton"
                                    Content="{DynamicResource Static.InternalInstall.Backup.StartButton}"
                                    Click="OnBackupBootMaintenance"
                                    Theme="{StaticResource PrimaryButton}"
                                    IsEnabled="False" />
                        </WrapPanel>
                        <ProgressBar x:Name="BootMaintenanceBackupProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="6"
                                     Margin="0,14,0,0" />
                        <TextBlock x:Name="BootMaintenanceBackupStatusText"
                                   Classes="BodyInkText"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Backup.StatusInitial}" />
                        <TextBlock x:Name="BootMaintenanceBackupVerifiedText"
                                   Classes="CaptionText"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Backup.VerifiedInitial}" />
                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.DetailTitle}" Classes="H2Text" />
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.DetailDirectoryLabel}" Classes="FieldLabelText" Margin="0,10,0,4" />
                                <TextBlock x:Name="BootMaintenanceBackupDirectoryText" Classes="FieldValueText" Text="—" />
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.DetailManifestLabel}" Classes="FieldLabelText" Margin="0,8,0,4" />
                                <TextBlock x:Name="BootMaintenanceBackupManifestText" Classes="FieldValueText" Text="—" />
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Backup.DetailManifestHashLabel}" Classes="FieldLabelText" Margin="0,8,0,4" />
                                <TextBlock x:Name="BootMaintenanceBackupManifestHashText" Classes="FieldValueText" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.CoverageTitle}" Classes="H2Text" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Backup.Coverage}" Classes="BodyText" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 03 准备引导：原厂恢复来源；更新后修复另有项目备份与系统安装包。 -->
                    <StackPanel x:Name="BootMaintenanceSourcesPage" IsVisible="False" Margin="0,18,0,0">
                        <TextBlock x:Name="BootMaintenanceSourcesTitle"
                                   Text="{DynamicResource Dynamic.BootMaintenance.SourceTitle}"
                                   Classes="H1Text" />
                        <TextBlock x:Name="BootMaintenanceSourcesLead"
                                   Text="{DynamicResource Dynamic.BootMaintenance.SourceLead}"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.OriginalSource}"
                                           Classes="FieldLabelText"
                                           Margin="0,0,0,6" />
                                <Grid x:Name="BootMaintenanceOriginalGrid" ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="BootMaintenanceOriginalBox"
                                             Grid.Column="0"
                                             Theme="{StaticResource InputTextBox}"
                                             IsReadOnly="True" />
                                    <Button x:Name="BootMaintenanceOriginalBrowseButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Static.Browse}"
                                            Click="OnBrowseBootMaintenanceOriginal"
                                            Theme="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="BootMaintenanceFreshBackupHint"
                                           Text="{DynamicResource Dynamic.BootMaintenance.FreshBackup}"
                                           Classes="CaptionText"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />

                                <StackPanel x:Name="BootMaintenanceRepairSourcesRow"
                                            IsVisible="False"
                                            Margin="0,14,0,0">
                                    <TextBlock x:Name="BootMaintenanceProjectLabel"
                                               Text="{DynamicResource Dynamic.BootMaintenance.ProjectSource}"
                                               Classes="FieldLabelText"
                                               Margin="0,0,0,6" />
                                    <Grid x:Name="BootMaintenanceProjectGrid" ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="BootMaintenanceProjectBox"
                                                 Grid.Column="0"
                                                 Theme="{StaticResource InputTextBox}"
                                                 IsReadOnly="True" />
                                        <Button x:Name="BootMaintenanceProjectBrowseButton"
                                                Grid.Column="1"
                                                Content="{DynamicResource Static.Browse}"
                                                Click="OnBrowseBootMaintenanceProject"
                                                Theme="{StaticResource SecondaryButton}"
                                                Margin="10,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.Package}"
                                               Classes="FieldLabelText"
                                               Margin="0,12,0,6" />
                                    <TextBox x:Name="BootMaintenancePackageBox"
                                             Theme="{StaticResource InputTextBox}"
                                             TextChanged="OnBootMaintenancePackagePathChanged" />
                                    <TextBlock x:Name="BootMaintenancePackageHint"
                                               Text="{DynamicResource Dynamic.BootMaintenance.PackageHint}"
                                               Classes="CaptionText"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="BootMaintenancePrepareStatusText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- 04 确认操作：只陈述 Core 真实准备的结果；执行按钮在本页底部。 -->
                    <StackPanel x:Name="BootMaintenanceConfirmPage" IsVisible="False" Margin="0,18,0,0">
                        <TextBlock x:Name="BootMaintenanceConfirmTitle"
                                   Text="{DynamicResource Dynamic.BootMaintenance.ConfirmTitle}"
                                   Classes="H1Text" />
                        <TextBlock x:Name="BootMaintenanceDeviceText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="BootMaintenanceBackupLocationsText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <StackPanel x:Name="BootMaintenanceSlotsPanel" Margin="0,12,0,0" />

                        <Expander x:Name="BootMaintenanceRegionsPanel"
                                  Theme="{StaticResource SectionExpander}"
                                  Margin="0,12,0,0">
                            <Expander.Header>
                                <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.RegionsTitle}" Classes="BodyInkText" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel x:Name="BootMaintenanceRegionsHost" />
                        </Expander>

                        <CheckBox x:Name="BootMaintenanceRiskCheck"
                                  IsCheckedChanged="OnBootMaintenanceRiskChanged"
                                  Margin="0,14,0,0">
                            <TextBlock x:Name="BootMaintenanceRiskText" TextWrapping="Wrap" FontSize="13" />
                        </CheckBox>

                        <TextBlock x:Name="BootMaintenanceConfirmStatusText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                        <TextBlock x:Name="BootMaintenanceProgressText"
                                   Classes="CaptionText"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <ProgressBar x:Name="BootMaintenanceProgressBar"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 本页的上一步 / 下一步 / 执行（WPF 窗口用共享底栏）。 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="BootMaintenancePrevButton"
                                Content="{DynamicResource Static.Previous}"
                                Click="OnBootMaintenancePrevious"
                                IsEnabled="False"
                                Theme="{StaticResource SecondaryButton}" />
                        <Button x:Name="BootMaintenanceNextButton"
                                Content="{DynamicResource Static.Next}"
                                Click="OnBootMaintenanceNext"
                                IsEnabled="False"
                                Theme="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" />
                        <Button x:Name="BootMaintenanceActionButton"
                                Click="OnExecuteBootMaintenance"
                                IsEnabled="False"
                                IsVisible="False"
                                Theme="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0">
                            <TextBlock x:Name="BootMaintenanceActionButtonText" />
                        </Button>
                    </StackPanel>

                    <!-- 仍有真实 9008 现场且未真实完成时显示：一次复位离开。 -->
                    <Border x:Name="BootMaintenanceExitPanel"
                            Classes="CardBorder"
                            Margin="0,16,0,0"
                            IsVisible="False">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Exit.Title}" Classes="H2Text" />
                            <Button x:Name="BootMaintenanceExitButton"
                                    Content="{DynamicResource Dynamic.BootMaintenance.Exit.Button}"
                                    Click="OnExitBootMaintenance"
                                    Theme="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                            <TextBlock x:Name="BootMaintenanceExitStatusText"
                                       Classes="BodyText"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="{DynamicResource Dynamic.BootMaintenance.Exit.Ready}" />
                        </StackPanel>
                    </Border>

                    <!-- 四步共用的日志 -->
                    <Border Classes="CardBorder" Margin="0,16,0,0">
                        <Expander Theme="{StaticResource SectionExpander}" Margin="0" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Log.Title}" Classes="H2Text" />
                            </Expander.Header>
                            <ScrollViewer x:Name="BootMaintenanceLogScrollViewer"
                                          Height="160"
                                          Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="BootMaintenanceLogEmptyText"
                                               Text="{DynamicResource Dynamic.InternalInstall.Log.Empty}"
                                               Classes="CaptionText" />
                                    <StackPanel x:Name="BootMaintenanceLogList" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 卸载 Linux（与 WPF 窗口卸载向导的三步一致：检查、恢复资料、确认；控件名加 Uninstall 前缀） ================= -->
            <ScrollViewer x:Name="UninstallPage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="False"
                          Padding="0,0,14,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <Button x:Name="UninstallBackButton"
                            Content="{DynamicResource Dynamic.BackToFunctions}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnUninstallBackHome"
                            HorizontalAlignment="Left"
                            Padding="8,4"
                            Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource Dynamic.Mode.Uninstall}" Classes="H1Text" />
                    <TextBlock Text="{DynamicResource Dynamic.ModeHint.Uninstall}" Classes="BodyText" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <!-- 三步导航：WPF 共享四步侧栏在卸载中隐藏内部第 1 步，显示序号 01/02/03；Tag 用内部步骤号 0/2/3。 -->
                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <RadioButton x:Name="UninstallNavCheck"
                                     GroupName="UninstallSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="0"
                                     IsChecked="True"
                                     IsCheckedChanged="OnUninstallNavChecked"
                                     Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="01" FontSize="11" />
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Nav.Connect}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="UninstallNavSources"
                                     GroupName="UninstallSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="2"
                                     IsCheckedChanged="OnUninstallNavChecked"
                                     Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="02" FontSize="11" />
                                <TextBlock Text="{DynamicResource Dynamic.UserdataUninstall.Nav.Sources}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="UninstallNavConfirm"
                                     GroupName="UninstallSteps"
                                     Theme="{StaticResource StepNavItem}"
                                     Tag="3"
                                     IsCheckedChanged="OnUninstallNavChecked">
                            <StackPanel>
                                <TextBlock Text="03" FontSize="11" />
                                <TextBlock Text="{DynamicResource Dynamic.UserdataUninstall.Nav.Confirm}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- 01 连接检测：默认走完整自动检查（安卓 -> Fastboot -> 安卓，取得锁态）；9008 路线读板内 / 电脑恢复资料核对身份。 -->
                    <StackPanel x:Name="UninstallCheckPage" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource Static.InternalInstall.Check.Title}" Classes="H1Text" />
                        <TextBlock Text="{DynamicResource Dynamic.Shared.DeviceCheckLead}" Classes="BodyText" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Static.Connection.Gen4UsbPortHint}"
                                   Classes="BodyInkText"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <TextBlock x:Name="UninstallDevicesLabel"
                                   Text="{DynamicResource Static.InternalInstall.Check.DeviceLabel}"
                                   Classes="FieldLabelText"
                                   Margin="0,14,0,6"
                                   IsVisible="False" />
                        <ComboBox x:Name="UninstallDevicesCombo"
                                  SelectionChanged="OnUninstallDeviceSelected"
                                  IsEnabled="False"
                                  IsVisible="False" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="UninstallCheckButton"
                                    Click="OnCheckUninstallDevice"
                                    Theme="{StaticResource PrimaryButton}">
                                <TextBlock x:Name="UninstallCheckButtonText" Text="{DynamicResource Static.InternalInstall.Check.Button}" />
                            </Button>
                        </WrapPanel>

                        <!-- WPF 在卸载中隐藏 9008 入口的历史说明与原厂目录行，只保留「平板已在 9008」与高级检查。 -->
                        <StackPanel x:Name="UninstallEntryPanel" Margin="0,14,0,0">
                            <CheckBox x:Name="UninstallAlreadyEdlCheck"
                                      Content="{DynamicResource Dynamic.BootMaintenance.AlreadyEdl}"
                                      IsCheckedChanged="OnUninstallEdlRouteChanged" />

                            <Expander Theme="{StaticResource SectionExpander}" IsExpanded="False" Margin="0,12,0,0">
                                <Expander.Header>
                                    <TextBlock Text="{DynamicResource Dynamic.Shared.AdvancedCheckHeader}"
                                               Classes="BodyInkText"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Dynamic.Shared.AdvancedCheckWarning}"
                                               Classes="CaptionText"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,6" />
                                    <Button x:Name="UninstallFastbootCheckButton"
                                            Content="{DynamicResource Dynamic.Shared.AdvancedCheckButton}"
                                            Click="OnCheckUninstallDeviceAdvanced"
                                            Theme="{StaticResource SecondaryButton}"
                                            IsEnabled="False"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <TextBlock x:Name="UninstallCheckProgressText"
                                   Classes="BodyInkText"
                                   Margin="0,12,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Check.ProgressInitial}" />
                        <TextBlock x:Name="UninstallCheckStatusText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="{DynamicResource Static.InternalInstall.Check.StatusInitial}" />

                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.InternalInstall.Check.FieldsTitle}" Classes="H2Text" />
                                <Grid Margin="0,10,0,0" ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Static.FieldModel}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UninstallModelText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Static.FieldSerial}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UninstallSerialText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Static.FieldFirmware}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UninstallFirmwareText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Static.FieldBootState}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UninstallBootloaderText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Field.Route}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UninstallRouteText" Text="—" Classes="FieldValueText" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Static.InternalInstall.Field.Power}" Classes="FieldLabelText" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="UninstallPowerText" Text="—" Classes="FieldValueText" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 02 恢复资料与引导选项：电脑原厂备份可选（不选时用板内恢复资料）；「下一步」自动另存当前状态快照并真实准备。 -->
                    <StackPanel x:Name="UninstallSourcesPage" IsVisible="False" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource Dynamic.UserdataUninstall.SourceTitle}" Classes="H1Text" />
                        <TextBlock Text="{DynamicResource Dynamic.UserdataUninstall.SourceLead}"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <Border Classes="CardBorder" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dynamic.UserdataUninstall.OriginalSource}"
                                           Classes="FieldLabelText"
                                           Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="UninstallOriginalBox"
                                             Grid.Column="0"
                                             Theme="{StaticResource InputTextBox}"
                                             IsReadOnly="True" />
                                    <Button x:Name="UninstallOriginalBrowseButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Static.Browse}"
                                            Click="OnBrowseUninstallOriginal"
                                            Theme="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" />
                                </Grid>
                                <TextBlock Text="{DynamicResource Dynamic.UserdataUninstall.FreshBackupHint}"
                                           Classes="CaptionText"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />

                                <Button x:Name="UninstallUseBoardBackupButton"
                                        Content="{DynamicResource Dynamic.UserdataUninstall.UseBoardBackup}"
                                        Click="OnUseBoardUninstallBackup"
                                        Theme="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0" />
                                <CheckBox x:Name="UninstallReclaimBackupCheck"
                                          Content="{DynamicResource Dynamic.UserdataUninstall.ReclaimBackup}"
                                          IsChecked="True"
                                          IsCheckedChanged="OnUserdataUninstallReclaimBackupChanged"
                                          Margin="0,10,0,0" />
                                <CheckBox x:Name="UninstallRestoreStockCheck"
                                          IsCheckedChanged="OnUserdataUninstallRestoreStockChanged"
                                          Margin="0,10,0,0">
                                    <TextBlock x:Name="UninstallRestoreStockText"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Text="{DynamicResource Dynamic.UserdataUninstall.RestoreStock.Label}" />
                                </CheckBox>
                                <TextBlock x:Name="UninstallRestoreStockHint"
                                           Classes="CaptionText"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           IsVisible="False"
                                           Text="{DynamicResource Dynamic.UserdataUninstall.RestoreStock.Hint}" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UninstallPrepareStatusText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- 03 确认删除 Linux：只陈述 Core 真实准备的结果；执行按钮在本页底部。 -->
                    <StackPanel x:Name="UninstallConfirmPage" IsVisible="False" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource Dynamic.UserdataUninstall.ConfirmTitle}" Classes="H1Text" />
                        <TextBlock x:Name="UninstallDeviceText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="UninstallCapacityText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <StackPanel x:Name="UninstallSlotsPanel" Margin="0,12,0,0" />

                        <Expander x:Name="UninstallRegionsPanel"
                                  Theme="{StaticResource SectionExpander}"
                                  Margin="0,12,0,0">
                            <Expander.Header>
                                <TextBlock Text="{DynamicResource Dynamic.BootMaintenance.RegionsTitle}" Classes="BodyInkText" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel x:Name="UninstallRegionsHost" />
                        </Expander>

                        <!-- 确认页上的恢复原厂引导复选框（与来源页共用同一状态）。 -->
                        <CheckBox x:Name="UninstallConfirmRestoreStockCheck"
                                  IsCheckedChanged="OnUserdataUninstallRestoreStockChanged"
                                  Margin="0,14,0,0">
                            <TextBlock x:Name="UninstallConfirmRestoreStockText"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Text="{DynamicResource Dynamic.UserdataUninstall.RestoreStock.Label}" />
                        </CheckBox>
                        <TextBlock x:Name="UninstallConfirmRestoreStockHint"
                                   Classes="CaptionText"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   IsVisible="False"
                                   Text="{DynamicResource Dynamic.UserdataUninstall.RestoreStock.Hint}" />

                        <CheckBox x:Name="UninstallRiskCheck"
                                  IsCheckedChanged="OnUninstallRiskChanged"
                                  Margin="0,14,0,0">
                            <TextBlock x:Name="UninstallRiskText"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Text="{DynamicResource Dynamic.UserdataUninstall.Risk.Confirm}" />
                        </CheckBox>

                        <TextBlock x:Name="UninstallConfirmStatusText"
                                   Classes="BodyText"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                        <TextBlock x:Name="UninstallProgressText"
                                   Classes="CaptionText"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <ProgressBar x:Name="UninstallProgressBar"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 本页的上一步 / 下一步 / 执行（WPF 窗口用共享底栏）。 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="UninstallPrevButton"
                                Content="{DynamicResource Static.Previous}"
                                Click="OnUninstallPrevious"
                                IsEnabled="False"
                                Theme="{StaticResource SecondaryButton}" />
                        <Button x:Name="UninstallNextButton"
                                Content="{DynamicResource Static.Next}"
                                Click="OnUninstallNext"
                                IsEnabled="False"
                                Theme="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" />
                        <Button x:Name="UninstallActionButton"
                                Content="{DynamicResource Dynamic.UserdataUninstall.Execute}"
                                Click="OnExecuteUninstall"
                                IsEnabled="False"
                                IsVisible="False"
                                Theme="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- 仍有真实 9008 现场且未真实完成时显示：一次复位离开。 -->
                    <Border x:Name="UninstallExitPanel"
                            Classes="CardBorder"
                            Margin="0,16,0,0"
                            IsVisible="False">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Exit.Title}" Classes="H2Text" />
                            <Button x:Name="UninstallExitButton"
                                    Content="{DynamicResource Dynamic.UserdataUninstall.Exit.Button}"
                                    Click="OnExitUninstall"
                                    Theme="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                            <TextBlock x:Name="UninstallExitStatusText"
                                       Classes="BodyText"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="{DynamicResource Dynamic.UserdataUninstall.Exit.Ready}" />
                        </StackPanel>
                    </Border>

                    <!-- 三步共用的日志 -->
                    <Border Classes="CardBorder" Margin="0,16,0,0">
                        <Expander Theme="{StaticResource SectionExpander}" Margin="0" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="{DynamicResource Dynamic.InternalInstall.Log.Title}" Classes="H2Text" />
                            </Expander.Header>
                            <ScrollViewer x:Name="UninstallLogScrollViewer"
                                          Height="160"
                                          Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="UninstallLogEmptyText"
                                               Text="{DynamicResource Dynamic.InternalInstall.Log.Empty}"
                                               Classes="CaptionText" />
                                    <StackPanel x:Name="UninstallLogList" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 关于项目（与 WPF 窗口的关于页一致） ================= -->
            <ScrollViewer x:Name="SupportPage"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,14,0"
                          Margin="0,0,0,12"
                          IsVisible="False">
                <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                    <Button Content="{DynamicResource Static.SupportBack}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnCloseSupport"
                            HorizontalAlignment="Left"
                            Padding="0,4"
                            Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Static.SupportTitle}" Classes="H1Text" />

                    <!-- 项目简介与版本 -->
                    <Border Classes="CardBorder" Padding="16" Margin="0,16,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dynamic.AboutIntroTitle}" Classes="H2Text" Margin="0,0,0,8" />
                            <TextBlock Text="{DynamicResource Dynamic.AboutIntroBody}" Classes="BodyText" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Dynamic.AboutCurrentVersion}"
                                           Classes="CaptionText"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock x:Name="AboutVersionText" Classes="BodyInkText" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{DynamicResource Dynamic.AboutRepository}"
                                        Theme="{StaticResource SecondaryButton}"
                                        Click="OnOpenAboutRepository" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 开发者 -->
                    <TextBlock Text="{DynamicResource Dynamic.AboutDevelopers}" Classes="H2Text" Margin="0,12,0,8" />
                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,4">
                        <Border Classes="CardBorder" Padding="14" MinHeight="108" Margin="0,0,8,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="/Assets/about-mydanyi.jpg"
                                       Width="56"
                                       Height="56"
                                       Stretch="UniformToFill"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="{DynamicResource Static.AuthorName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Static.AuthorName}"
                                               Classes="H2Text"
                                               FontSize="17"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Dynamic.AboutRoleAuthor}"
                                               Classes="CaptionText"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{DynamicResource Static.AuthorGithub}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenGithub"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                        <Button Content="{DynamicResource Static.AuthorBilibili}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenBilibili"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="CardBorder" Padding="14" MinHeight="108" Margin="4,0,4,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="/Assets/about-lich-wang.jpg"
                                       Width="56"
                                       Height="56"
                                       Stretch="UniformToFill"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="{DynamicResource Dynamic.AboutLichWangName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Dynamic.AboutLichWangName}"
                                               Classes="H2Text"
                                               FontSize="17"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Dynamic.AboutRoleDeveloper}"
                                               Classes="CaptionText"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{DynamicResource Static.AuthorGithub}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenLichWangGithub"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                        <Button Content="{DynamicResource Static.AuthorBilibili}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenLichWangBilibili"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="CardBorder" Padding="14" MinHeight="108" Margin="8,0,8,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="/Assets/about-h0cheung.png"
                                       Width="56"
                                       Height="56"
                                       Stretch="UniformToFill"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="{DynamicResource Dynamic.AboutH0CheungName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Dynamic.AboutH0CheungName}"
                                               Classes="H2Text"
                                               FontSize="17"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Dynamic.AboutRoleDeveloper}"
                                               Classes="CaptionText"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{DynamicResource Static.AuthorGithub}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenH0CheungGithub"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                        <Button Content="{DynamicResource Static.AuthorBilibili}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenH0CheungBilibili"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="CardBorder" Padding="14" MinHeight="108" Margin="8,0,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="/Assets/about-cody.png"
                                       Width="56"
                                       Height="56"
                                       Stretch="UniformToFill"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="{DynamicResource Dynamic.AboutCodyName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Dynamic.AboutCodyName}"
                                               Classes="H2Text"
                                               FontSize="17"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Dynamic.AboutRoleDeveloper}"
                                               Classes="CaptionText"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{DynamicResource Static.AuthorGithub}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenCodyGithub"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                        <Button Content="{DynamicResource Static.AuthorBilibili}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenCodyBilibili"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- 特别感谢 -->
                    <TextBlock Text="{DynamicResource Dynamic.AboutSpecialThanks}" Classes="H2Text" Margin="0,12,0,8" />
                    <UniformGrid Columns="2" Rows="1" Margin="0,0,0,4">
                        <Border Classes="CardBorder" Padding="14" MinHeight="108" Margin="0,0,8,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="/Assets/about-sunflower2333.png"
                                       Width="56"
                                       Height="56"
                                       Stretch="UniformToFill"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="{DynamicResource Dynamic.AboutSunflowerName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Dynamic.AboutSunflowerName}"
                                               Classes="H2Text"
                                               FontSize="17"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{DynamicResource Static.AuthorGithub}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenSunflowerGithub"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="CardBorder" Padding="14" MinHeight="108" Margin="8,0,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="/Assets/about-bilibili-509773383.jpg"
                                       Width="56"
                                       Height="56"
                                       Stretch="UniformToFill"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="{DynamicResource Dynamic.AboutBilibiliThanksName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Dynamic.AboutBilibiliThanksName}"
                                               Classes="H2Text"
                                               FontSize="17"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{DynamicResource Static.AuthorBilibili}"
                                                Theme="{StaticResource GhostButton}"
                                                Click="OnOpenBilibiliThanks"
                                                Padding="0,4"
                                                Margin="0,0,12,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- 社区与反馈 -->
                    <TextBlock Text="{DynamicResource Dynamic.AboutCommunity}" Classes="H2Text" Margin="0,16,0,8" />
                    <Border Classes="CardBorder" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dynamic.AboutQqGroup}" Classes="BodyInkText" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Dynamic.AboutQqNumber}" Classes="BodyInkText" Margin="0,4,0,0" />
                            <TextBlock Text="{DynamicResource Dynamic.AboutQqInvitation}"
                                       Classes="BodyText"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <Button Content="{DynamicResource Dynamic.AboutJoinQq}"
                                    Theme="{StaticResource SecondaryButton}"
                                    Click="OnOpenQqGroupInvite"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 支持项目 -->
                    <TextBlock Text="{DynamicResource Dynamic.AboutSupportSection}" Classes="H2Text" Margin="0,16,0,8" />
                    <TextBlock Text="{DynamicResource Static.SupportSponsor}"
                               Classes="BodyText"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <WrapPanel>
                        <Border Classes="CardBorder" Width="300" Padding="20" Margin="0,0,16,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.SupportAlipayTitle}" Classes="H2Text" />
                                <TextBlock Text="{DynamicResource Static.SupportAlipayScan}"
                                           Classes="BodyText"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,8" />
                                <Border Background="White" Padding="12" CornerRadius="8" HorizontalAlignment="Center">
                                    <Image Width="200" Height="200" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           AutomationProperties.Name="{DynamicResource Static.SupportAlipayQrAutomationName}">
                                        <Image.Source>
                                            <CroppedBitmap Source="/Assets/sponsor-zh.png" SourceRect="435,432,330,324" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Classes="CardBorder" Width="300" Padding="20" Margin="0,0,16,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Static.SupportWeChatTitle}" Classes="H2Text" />
                                <TextBlock Text="{DynamicResource Static.SupportWeChatScan}"
                                           Classes="BodyText"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,8" />
                                <Border Background="White" Padding="12" CornerRadius="8" HorizontalAlignment="Center">
                                    <Image Width="200" Height="200" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           AutomationProperties.Name="{DynamicResource Static.SupportWeChatQrAutomationName}">
                                        <Image.Source>
                                            <CroppedBitmap Source="/Assets/sponsor-zh.png" SourceRect="950,446,292,292" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{DynamicResource Static.SupportNote}" Classes="BodyInkText" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock Text="{DynamicResource Static.SupportTail}" Classes="CaptionText" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= 底栏：作者在左，免费声明居中，主操作在右 ================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Static.AuthorLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Static.AuthorName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="{DynamicResource Static.AuthorBilibili}"
                                Theme="{StaticResource GhostButton}"
                                Click="OnOpenBilibili"
                                ToolTip.Tip="https://space.bilibili.com/258786"
                                FontSize="11"
                                Padding="0,2"
                                HorizontalAlignment="Left" />
                        <Button Content="{DynamicResource Static.AuthorGithub}"
                                Theme="{StaticResource GhostButton}"
                                Click="OnOpenGithub"
                                ToolTip.Tip="https://github.com/mydanyi"
                                FontSize="11"
                                Padding="0,2"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Background="{DynamicResource StrokeBrush}" Margin="16,2" />
                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Static.FreeWarn}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           ToolTip.Tip="{DynamicResource Static.FreeWarnDetail}" />
                <TextBlock x:Name="HomeFooterHint"
                           Grid.Column="3"
                           Text="{DynamicResource Static.HomeFooterHint}"
                           FontSize="12.5"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           IsVisible="False" />
                <StackPanel x:Name="WorkflowButtons"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsVisible="False">
                    <Button x:Name="PrevButton"
                            Content="{DynamicResource Static.Previous}"
                            Click="OnPreviousPage"
                            IsEnabled="False"
                            Theme="{StaticResource SecondaryButton}" />
                    <Button x:Name="NextButton"
                            Content="{DynamicResource Static.Next}"
                            Click="OnNextPage"
                            Theme="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" />
                    <Button x:Name="ActionButton"
                            Content="{DynamicResource Static.ActionInstall}"
                            Click="OnExecuteSelectedWorkflow"
                            IsEnabled="False"
                            Theme="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            IsVisible="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
